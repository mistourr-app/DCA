-- Скрипт мира: связка core/* с экраном (docs/ARCHITECTURE.md §5, §9).
-- Вся логика — в core/. Здесь: прокрутка ряда, карты клеток, тап, лагерь, смерть, сохранение.
-- Клетки — персистентные объекты в контейнере rows: diff-синхронизация по содержимому,
-- полное пересоздание только при выходе ряда из окна (нужно для будущих анимаций).
-- Анимаций пока нет: события применяются сразу (анимации — позже по anim.*).
-- Все тексты на экране — английские (docs/CONVENTIONS.md §1).

local run = require("core.run")
local world = require("core.world")
local row_gen = require("core.row_gen")
local layout = require("core.layout")
local equipment = require("core.equipment")
local death = require("core.death")
local camp = require("core.camp")
local upgrades = require("core.upgrades")
local save_schema = require("core.save_schema")
local registry = require("core.registry.init")
local balance = require("core.data.balance")
local saves = require("scripts.saves")
local arena = require("core.arena")
local highlight = require("core.highlight")
local design = require("core.data.design")
local rng = require("core.rng")
local row_seed = require("core.row_seed")

local MODES = world.MODES
local BUTTON_HEIGHT = layout.MARGIN_BOTTOM

-- Слои отрисовки (position.z). Default-камера Defold рендерит только z в [-1..1], вне диапазона
-- объект молча не рисуется; больше z = ближе к камере; равный z = порядок не определён.
-- label в cell.go поднят на +0.2 внутри GO: «содержимое» клетки остаётся поверх слоя угроз.
-- Клетки < слой угроз < персонажи < красный «вас видят» (под своей надписью) < обводки < пунктир.
local Z_CELL = 0
local Z_THREAT = 0.1
local Z_ACTOR = 0.3
local Z_SPOTTED = 0.4
local Z_OUTLINE = 0.6
local Z_DASH = 0.7

-- Зазор между клетками: спрайты клеток, оверлеи и обводки входят в него с отступом.
local GAP = 8

-- Цвета из GDD §12. Фон клетки (fill) и цвет подписи (ink) задаются отдельно.
local function rgb(r, g, b)
	return vmath.vector4(r / 255, g / 255, b / 255, 1)
end
local SYMBOL = {
	EMPTY = { text = "", fill = rgb(26, 29, 40), ink = rgb(26, 29, 40) },
	WALL = { text = "#", fill = rgb(63, 69, 86), ink = rgb(160, 166, 180) },
	HEAL = { text = "+", fill = rgb(16, 185, 129), ink = rgb(0, 0, 0) },
	GOLD = { text = "$", fill = rgb(255, 231, 97), ink = rgb(0, 0, 0) },
	ENEMY = { text = "E", fill = rgb(255, 31, 31), ink = rgb(255, 255, 255) },
	CAMP = { text = "C", fill = rgb(92, 250, 255), ink = rgb(0, 0, 0) },
	ATTACK_CELL = { text = "A", fill = rgb(196, 0, 20), ink = rgb(255, 255, 255) },
}
local PLAYER = { text = "@", fill = rgb(255, 255, 255), ink = rgb(0, 0, 0) }

-- Подсветки (GDD §5.4, §12): шаг — зелёная, прыжок — фиолетовая, атака — красная, пунктир выстрела — белый.
local OUTLINE = {
	step = rgb(16, 185, 129),
	jump = rgb(158, 109, 255),
	attack = rgb(255, 31, 31),
}
local DOT_COLOR = rgb(255, 255, 255)
-- Зрение врагов: оранжевый оверлей на видимые клетки; красный — клетка игрока, когда его видят.
local VISION_COLOR = rgb(255, 115, 27)
local SPOTTED_COLOR = rgb(255, 31, 31)

local function has_event(events, type_)
	for _, e in ipairs(events) do
		if e.type == type_ then
			return true
		end
	end
	return false
end

-- Клетки ряда y; ряд генерируется по seed при первом обращении и кэшируется.
local function get_row(self, y)
	if y < 0 then
		return nil
	end
	local cells = self.rows[y]
	if cells == nil then
		cells = row_gen.generate(self.seed, self.world.respawn_count, y).cells
		self.rows[y] = cells
	end
	return cells
end

-- Источник содержимого ряда на экране: в бою ряды берутся из состояния арены,
-- остальные — из генератора (ряды типа boss без боя пусты).
local function content_row(self, y)
	local a = self.arena
	if self.world.mode == MODES.BOSS and a ~= nil then
		local pr = self.world.pos.y
		if y == pr then
			return a.player_row
		end
		if y == pr + 1 then
			return a.boss_row
		end
	end
	return get_row(self, y)
end

-- Подпись содержимого клетки: меняется, когда нужно переслать "set".
local function cell_sig(cell)
	if cell.type == "ENEMY" then
		return "ENEMY:" .. tostring(cell.enemy) .. ":" .. tostring(cell.hp or "")
	end
	return cell.type
end

local function cell_view(cell)
	local sym = SYMBOL[cell.type] or SYMBOL.EMPTY
	local text = sym.text
	if cell.type == "ENEMY" then
		local t = registry.enemies.types[cell.enemy]
		text = t.label:sub(1, 1) .. tostring(cell.hp or t.base_hp)
	end
	return text, sym.fill, sym.ink
end

local function card_msg(x, y, text, fill, ink)
	local h = layout.row_height(y)
	return { text = text, color = fill, text_color = ink,
		width = layout.CELL_W - GAP, height = h - GAP }
end

-- Клетка-карта в контейнере рядов: локальные координаты = пространство рядов.
local function create_card(self, x, y, z)
	local pos = vmath.vector3(layout.cell_x(x), layout.world_center(y), z)
	local id = factory.create("#cell_factory", pos)
	if id == nil then
		print("card create failed: label buffer full (raise [label] max_count in game.project)")
		return nil
	end
	go.set_parent(id, self.rows_id, false)
	return id
end

local function update_card(self, id, x, y, z, text, fill, ink)
	go.set(id, "position", vmath.vector3(layout.cell_x(x), layout.world_center(y), z))
	msg.post(id, "set", card_msg(x, y, text, fill, ink))
end

-- Прямоугольник без надписи (обводка, точка пунктира, оверлей угрозы). Эфемерный: в self.fx.
local function spawn_bar(self, cx, cy, w, h, color, z)
	local id = factory.create("#bar_factory", vmath.vector3(cx, cy, z))
	if id == nil then
		print("bar spawn failed: sprite buffer full (raise [sprite] max_count in game.project)")
		return
	end
	go.set_parent(id, self.rows_id, false)
	msg.post(id, "set", { width = w, height = h, color = color })
	table.insert(self.fx, id)
end

-- Обводка клетки: четыре полоски в зазоре между клетками. Координаты — пространство рядов.
local BORDER = design.screen.borderWidth
local function draw_outline(self, cx, cy, w, h, color)
	local ox = (w - GAP) / 2 + BORDER / 2
	local oy = (h - GAP) / 2 + BORDER / 2
	spawn_bar(self, cx, cy + oy, w, BORDER, color, Z_OUTLINE)
	spawn_bar(self, cx, cy - oy, w, BORDER, color, Z_OUTLINE)
	spawn_bar(self, cx - ox, cy, BORDER, h, color, Z_OUTLINE)
	spawn_bar(self, cx + ox, cy, BORDER, h, color, Z_OUTLINE)
end

-- Тонкая пунктирная линия от точки (ax, ay) до (bx, by), верхний слой. Пространство рядов.
local DASH = design.screen.dashSize
local function draw_dashed(self, ax, ay, bx, by)
	for _, p in ipairs(highlight.dash_points(ax, ay, bx, by, highlight.DASH_STEP)) do
		spawn_bar(self, p.x, p.y, DASH, DASH, DOT_COLOR, Z_DASH)
	end
end

-- Оверлей угрозы поверх клетки: цвет с заданной непрозрачностью, в своём слое z.
local function draw_threat(self, cx, cy, h, color, alpha, z)
	spawn_bar(self, cx, cy, layout.CELL_W - GAP, h - GAP,
		vmath.vector4(color.x, color.y, color.z, alpha), z)
end

-- Нижний ряд арены (ряд игрока): ряд типа boss с остатком периода (PERIOD - ARENA_ROWS).
local PERIOD = balance.boss.period
local ARENA_ROWS = balance.boss.arenaRows

local function is_arena_bottom(y)
	return row_gen.kind(y) == "boss" and (y % PERIOD) == (PERIOD - ARENA_ROWS)
end

-- Diff-синхронизация видимых клеток: создаём новые, обновляем изменившиеся,
-- удаляем вышедшие из окна. Ряды ниже игрока не видны и не хранятся как объекты.
local function sync_cells(self, pr)
	local new_cards = {}
	for _, y in ipairs(layout.visible_rows(pr)) do
		local old = self.cards[y]
		local out = {}
		local row = content_row(self, y)
		for x = 0, layout.COLUMNS - 1 do
			local cell = (row and row[x]) or { type = "EMPTY" }
			local sig = cell_sig(cell)
			local card = old and old[x]
			if card == nil then
				local id = create_card(self, x, y, Z_CELL)
				if id ~= nil then
					local text, fill, ink = cell_view(cell)
					msg.post(id, "set", card_msg(x, y, text, fill, ink))
					card = { id = id, sig = sig }
				end
			elseif card.sig ~= sig then
				local text, fill, ink = cell_view(cell)
				msg.post(card.id, "set", card_msg(x, y, text, fill, ink))
				card.sig = sig
			end
			out[x] = card
		end
		if old ~= nil then
			for x, card in pairs(old) do
				if out[x] == nil then
					go.delete(card.id)
				end
			end
		end
		new_cards[y] = out
	end
	-- строки, вышедшие из окна: удаляем карты целиком
	local stale = {}
	for y in pairs(self.cards) do
		if new_cards[y] == nil then
			table.insert(stale, y)
		end
	end
	for _, y in ipairs(stale) do
		for _, card in pairs(self.cards[y]) do
			go.delete(card.id)
		end
		self.cards[y] = nil
	end
	self.cards = new_cards
end

-- Карта игрока: один персистентный объект, занимает клетку под собой и стоит над слоем угроз.
local function sync_player(self, pr)
	local pos = self.world.pos
	if self.player_go == nil then
		self.player_go = create_card(self, pos.x, pr, Z_ACTOR)
	end
	if self.player_go == nil then
		return
	end
	go.set(self.player_go, "position",
		vmath.vector3(layout.cell_x(pos.x), layout.world_center(pr), Z_ACTOR))
	msg.post(self.player_go, "set", card_msg(pos.x, pr, PLAYER.text, PLAYER.fill, PLAYER.ink))
end

-- Карта босса: отдельный объект на верхнем ряду арены; создаётся в бою, удаляется по его концу.
local function sync_boss(self, pr)
	local a = self.arena
	if self.world.mode ~= MODES.BOSS or a == nil then
		if self.boss_go ~= nil then
			go.delete(self.boss_go)
			self.boss_go = nil
		end
		return
	end
	local boss_y = pr + 1
	if self.boss_go == nil then
		self.boss_go = create_card(self, a.boss_x, boss_y, Z_ACTOR)
	end
	if self.boss_go == nil then
		return
	end
	update_card(self, self.boss_go, a.boss_x, boss_y, Z_ACTOR,
		"B" .. tostring(a.boss_hp), SYMBOL.ENEMY.fill, SYMBOL.ENEMY.ink)
end

-- Перерисовка: прокрутка контейнера, diff клеток, персонажи, эфемерные подсветки.
local function refresh(self)
	local pr = self.world.pos.y
	go.set(self.rows_id, "position", vmath.vector3(0, layout.container_y(pr), 0))
	sync_cells(self, pr)
	sync_player(self, pr)
	sync_boss(self, pr)
	for _, id in ipairs(self.fx) do
		go.delete(id)
	end
	self.fx = {}
	-- Слой угроз: поверх клеток, под персонажами и содержимым (GDD §5.4).
	for _, y in ipairs(layout.visible_rows(pr)) do
		local vision_row = highlight.vision(content_row(self, y), y)
		local cy = layout.world_center(y)
		local h = layout.row_height(y)
		for x = 0, layout.COLUMNS - 1 do
			local alpha = highlight.vision_alpha(vision_row[x])
			if alpha ~= nil then
				if y == pr and x == self.world.pos.x and self.world.mode == MODES.WORLD then
					-- Игрок в поле зрения: его клетка красная, поверх спрайта персонажа, под надписью.
					draw_threat(self, layout.cell_x(x), cy, h, SPOTTED_COLOR, alpha, Z_SPOTTED)
				else
					draw_threat(self, layout.cell_x(x), cy, h, VISION_COLOR, alpha, Z_THREAT)
				end
			end
		end
	end
	local reach = registry.equipment.CROSSBOW.range
	if self.world.mode == MODES.WORLD then
		-- Подсветка ходов на следующий ряд (шаг, прыжок, атака по врагу).
		local up_y = pr + 1
		for _, m in ipairs(highlight.moves(self.world.pos, self.player.hp, get_row(self, up_y))) do
			draw_outline(self, layout.cell_x(m.x), layout.world_center(up_y),
				layout.CELL_W, layout.row_height(up_y), OUTLINE[m.kind])
		end
		-- Пунктир до каждой цели, в которую выстрел возможен.
		local py = layout.world_center(pr)
		for _, x in ipairs(highlight.shot_targets(self.world.pos, get_row(self, pr), self.player.weapon, reach)) do
			draw_dashed(self, layout.cell_x(self.world.pos.x), py, layout.cell_x(x), py)
		end
	elseif self.world.mode == MODES.BOSS and self.arena ~= nil then
		-- Подсветка ходов по X на ряду игрока и пунктир выстрела по боссу.
		local a = self.arena
		for _, m in ipairs(highlight.arena_moves(a)) do
			draw_outline(self, layout.cell_x(m.x), layout.world_center(pr),
				layout.CELL_W, layout.row_height(pr), OUTLINE[m.kind])
		end
		local boss_x = highlight.arena_shot(a, self.player.weapon, reach)
		if boss_x ~= nil then
			draw_dashed(self, layout.cell_x(a.player_x), layout.world_center(pr),
				layout.cell_x(boss_x), layout.world_center(pr + 1))
		end
	end
end

-- Текст HUD и кнопки внизу экрана.
local function sync_hud(self)
	local p = self.player
	local pos = self.world.pos
	local top = string.format("ROW %d   HP %d/%d   CHARGES %d/%d   GOLD %d",
		pos.y, p.hp, p.max_hp, p.weapon.charges, p.weapon.max_charges, p.gold)
	if self.camp_state.pay_turns_left > 0 then
		top = top .. string.format("   CAMP FEE: %d TURNS", self.camp_state.pay_turns_left)
	end
	local bottom
	if self.world.mode == MODES.CAMP then
		bottom = "LEAVE CAMP"
	elseif self.world.mode == MODES.WORLD then
		bottom = string.format("MAKE CAMP (%d gold)", camp.install_price(p.gold))
	elseif self.world.mode == MODES.BOSS and self.arena then
		bottom = string.format("BOSS HP %d/%d", self.arena.boss_hp, self.arena.boss_max)
	else
		bottom = ""
	end
	msg.post("#hud", "update", {
		top = top,
		bottom = bottom,
		overlay = self.world.mode == MODES.DEATH,
	})
end

-- Клетки ряда точки возврата сохраняются целиком: этот ряд не пересоздаётся между сессиями.
local function return_point_for_save(self)
	local rp = self.world.return_point
	local out = { kind = rp.kind, row = rp.row, x = rp.x }
	local cells = get_row(self, rp.row)
	out.cells = {}
	for x = 0, layout.COLUMNS - 1 do
		out.cells[x + 1] = (cells[x] or { type = "EMPTY" }).type
	end
	return out
end

local function save(self)
	saves.write({
		version = save_schema.SCHEMA_VERSION,
		gold = self.player.gold,
		upgrades = self.upgrades,
		return_point = return_point_for_save(self),
	})
end

-- Смерть: переход в DEATH, оверлей. Возврат — по нажатию.
local function apply_events(self, events)
	for _, e in ipairs(events) do
		if e.type == "death" then
			print("DEATH at row " .. self.world.pos.y)
			for _, ev in ipairs(events) do
				print("  event " .. ev.type .. (ev.damage and (" damage=" .. ev.damage) or "") .. (ev.hp and (" hp=" .. ev.hp) or ""))
			end
			world.transition(self.world, MODES.DEATH)
		elseif e.type == "refused" then
			print("refused: " .. e.reason)
		end
	end
end

local function respawn(self)
	local player, lost = death.respawn(self.player, self.world.return_point.kind)
	if player == nil then
		print(lost)
		return
	end
	self.player = player
	self.run.player = player
	world.respawn(self.world)
	-- Ряды выше точки возврата генерируются заново с новым respawn_count (GDD §11).
	local rp_row = self.world.return_point.row
	local stale = {}
	for y in pairs(self.rows) do
		if y > rp_row then
			table.insert(stale, y)
		end
	end
	for _, y in ipairs(stale) do
		self.rows[y] = nil
	end
	print("respawn at " .. self.world.return_point.kind .. ", gold lost: " .. lost)
	save(self)
	sync_hud(self)
	refresh(self)
end

local function make_camp(self)
	local pos = self.world.pos
	local cells = get_row(self, pos.y)
	local res, reason = camp.install(self.camp_state, self.player.gold, cells)
	if res == nil then
		print(reason)
		return
	end
	for x = 0, layout.COLUMNS - 1 do
		cells[x] = res.cells[x]
	end
	self.player.gold = res.gold
	world.set_return_point(self.world, "camp", pos.y, pos.x)
	world.transition(self.world, MODES.CAMP)
	self.player.hp = self.player.max_hp
	equipment.restore(self.player.weapon)
	save(self)
	sync_hud(self)
	refresh(self)
end

local function leave_camp(self)
	camp.exit(self.camp_state)
	world.transition(self.world, MODES.WORLD)
	save(self)
	sync_hud(self)
end

-- Вход на арену: создаётся состояние боя, ряды арены генерируются по seed этого ряда.
local function enter_arena(self)
	local pos = self.world.pos
	local boss_number = (pos.y + ARENA_ROWS) / PERIOD
	local g = rng.new(row_seed.row_seed(self.seed, self.world.respawn_count, pos.y))
	local frac = self.player.hp / self.player.max_hp
	local pr, br = arena.generate_rows(g, arena.player_row_chances(frac))
	self.arena = arena.new(pos.x, self.player.hp, self.player.max_hp, boss_number, pr, br, g)
	-- Флаг «уже стрелял на ряду» — механика мира; в арене свой лимит (a.fired).
	-- Сбрасываем при входе, чтобы выстрел был доступен с первого хода боя (GDD §12.2).
	equipment.new_row(self.player.weapon)
	world.transition(self.world, MODES.BOSS)
	print("arena " .. boss_number .. " started at row " .. pos.y)
end

-- Исход боя: победа — чекпоинт выше арены, поражение — смерть.
local function arena_outcome(self)
	local res = arena.result(self.arena)
	if res == "victory" then
		world.boss_victory(self.world)
		self.arena = nil
		print("boss defeated, checkpoint at row " .. self.world.pos.y)
		save(self)
	elseif res == "defeat" then
		self.player.hp = 0
		self.arena = nil
		world.transition(self.world, MODES.DEATH)
		print("defeated by boss")
	end
	return res
end

-- Ход в бою: перемещение или атака клеткой, затем ход босса (если бой продолжается).
local function arena_move(self, x)
	local a = self.arena
	local ok, events = arena.player_move(a, x)
	if not ok then
		print("refused: " .. events)
		return
	end
	if arena.result(a) == nil then
		local boss_events = arena.boss_turn(a)
		for _, e in ipairs(boss_events) do
			table.insert(events, e)
		end
	end
	-- Завершённый ход игрока в арене, как в мире: тикает таймер перезарядки (GDD §7).
	equipment.tick(self.player.weapon)
	self.player.hp = a.player_hp
	self.world.pos.x = a.player_x
	arena_outcome(self)
	sync_hud(self)
	refresh(self)
end

local function arena_shoot(self)
	local a = self.arena
	local range = registry.equipment.CROSSBOW.range
	local ok, res = arena.shoot(a, self.player.weapon, self.player.weapon_damage, range)
	if not ok then
		print("refused: " .. tostring(res))
		return
	end
	if arena.result(a) == "victory" then
		arena_outcome(self)
	end
	sync_hud(self)
	refresh(self)
end

-- Ход на клетку / бой / выстрел только в режиме WORLD.
local function world_action(self, action_type, x, row)
	local events, ok
	-- Шаг на нижний ряд арены: игрок встаёт на него и входит в бой. Обычные клетки там не используются.
	if action_type == "step" and is_arena_bottom(row) then
		local moved, reason = world.move(self.world, { x = x, y = row })
		if not moved then
			print("refused: " .. tostring(reason))
			return
		end
		self.player.gold, _ = camp.tick_payment(self.camp_state, self.player.gold)
		enter_arena(self)
		sync_hud(self)
		refresh(self)
		return
	end
	if action_type == "step" then
		ok, events = run.step(self.run, x, row)
	elseif action_type == "melee" then
		ok, events = run.melee(self.run, x, row)
	else
		ok, events = run.shoot(self.run, x)
	end
	apply_events(self, events)
	if ok and has_event(events, "move") then
		self.player.gold, _ = camp.tick_payment(self.camp_state, self.player.gold)
		local pos = self.world.pos
		if row_gen.kind(pos.y) == "checkpoint" and pos.y > self.world.return_point.row then
			world.set_return_point(self.world, "checkpoint", pos.y, pos.x)
			save(self)
		end
		if is_arena_bottom(pos.y) then
			enter_arena(self)
		end
	end
	sync_hud(self)
	refresh(self)
end

function init(self)
	msg.post(".", "acquire_input_focus")
	self.rows_id = go.get_id("rows")
	local data, found = saves.load()
	-- Seed всегда новый: при каждом запуске генерируется новый мир (GDD §18).
	-- Из сохранения живут только золото, прокачка и точка возврата.
	self.seed = math.floor((os.time() + os.clock()) * 1000) % 2147483647
	self.upgrades = data.upgrades
	self.camp_state = camp.new_state()
	self.rows = {}
	self.cards = {}
	self.fx = {}
	self.player_go = nil
	self.boss_go = nil
	self.world = world.new(self.seed, 0)
	if found then
		local rp = data.return_point
		self.world.return_point = { kind = rp.kind, row = rp.row, x = rp.x }
		self.world.pos = { x = rp.x, y = rp.row }
		if rp.cells then
			-- Ряд точки возврата восстанавливается из сохранения, а не из генератора.
			local cells = {}
			for x = 0, layout.COLUMNS - 1 do
				cells[x] = { type = rp.cells[x + 1] }
			end
			self.rows[rp.row] = cells
		end
	end
	local stats = upgrades.stats({ levels = self.upgrades })
	self.player = {
		hp = stats.max_hp,
		max_hp = stats.max_hp,
		gold = data.gold,
		weapon = equipment.new(stats.max_charges, balance.player.weapon.rechargeTurns),
		weapon_damage = stats.weapon_damage,
	}
	self.run = {
		world = self.world,
		player = self.player,
		get_row = function(y)
			return get_row(self, y)
		},
	}
	if not found then
		save(self)
	end
	sync_hud(self)
	refresh(self)
end

function final(self)
	for _, row in pairs(self.cards) do
		for _, card in pairs(row) do
			go.delete(card.id)
		end
	end
	for _, id in ipairs(self.fx) do
		go.delete(id)
	end
	if self.player_go ~= nil then
		go.delete(self.player_go)
	end
	if self.boss_go ~= nil then
		go.delete(self.boss_go)
	end
	save(self)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return false
	end
	local mode = self.world.mode
	if mode == MODES.DEATH then
		respawn(self)
		return true
	end
	if action.y < BUTTON_HEIGHT then
		if mode == MODES.WORLD then
			make_camp(self)
		elseif mode == MODES.CAMP then
			leave_camp(self)
		end
		return true
	end
	local x, row = layout.cell_at(action.x, action.y, self.world.pos.y)
	if x == nil then
		return true
	end
	if mode == MODES.BOSS and self.arena then
		local pr = self.world.pos.y
		if row == pr and x ~= self.arena.player_x then
			arena_move(self, x)
		elseif row == pr + 1 and x == self.arena.boss_x then
			arena_shoot(self)
		end
		return true
	end
	if mode ~= MODES.WORLD then
		return true
	end
	local target = (get_row(self, row) or {})[x]
	if row == self.world.pos.y + 1 and target and target.type == "ENEMY" then
		world_action(self, "melee", x, row)
	elseif row == self.world.pos.y + 1 then
		world_action(self, "step", x, row)
	elseif row == self.world.pos.y and target and target.type == "ENEMY" then
		world_action(self, "shoot", x, row)
	end
	return true
end

-- Скрипт мира: связка core/* с экраном (docs/ARCHITECTURE.md §5, §9).
-- Вся логика — в core/. Здесь: прокрутка ряда, карты клеток, тап, лагерь, смерть, сохранение
-- и проигрывание событий ядра (этап C: выпады, падение карт, всплывающие цифры).
-- Клетки — персистентные объекты в контейнере rows: diff-синхронизация по содержимому.
-- Логика не ждёт анимацию: события применяются сразу, экран проигрывает таймлайн,
-- ввод блокирован до его конца, финальная синхронизация вью — в done.
-- Все тексты на экране — английские (docs/CONVENTIONS.md §1).

local run = require("core.run")
local world = require("core.world")
local row_gen = require("core.row_gen")
local layout = require("core.layout")
local equipment = require("core.equipment")
local death = require("core.death")
local camp = require("core.camp")
local upgrades = require("core.upgrades")
local save_schema = require("core.save_schema")
local registry = require("core.registry.init")
local balance = require("core.data.balance")
local saves = require("scripts.saves")
local arena = require("core.arena")
local highlight = require("core.highlight")
local rng = require("core.rng")
local row_seed = require("core.row_seed")
local fx = require("scripts.view.fx")
local timeline = require("scripts.view.timeline")
local board = require("scripts.view.board")
local hud = require("scripts.view.hud")
local style = require("scripts.view.style")
local layers = require("scripts.view.layers")
local palette = require("scripts.view.palette")

local MODES = world.MODES
local BUTTON_HEIGHT = layout.MARGIN_BOTTOM

-- Слои отрисовки (position.z) — единый источник scripts/view/layers.lua, порядок проверяет
-- tests/view/layers_test.lua. Снизу вверх: клетки < подсветки клеток < карты актёров < пунктир <
-- цифры. Подписи карт подняты на +0.2 компонентом в card.go (layers.LABEL_OFFSET).
local Z_THREAT = layers.THREAT
local Z_SPOTTED = layers.SPOTTED

-- Презентационные числа вынесены в config-скрипты на том же world.go
-- (docs/DEFOLD_INTEGRATION.md §5.2): geom_cfg, anim_cfg, flash_cfg.
-- Значения читаются один раз в init (go.get) и живут в self.
-- Палитра — отдельно: gui/palette.gui с цветовым пикером, приходит сообщением "palette".

-- debug_seed ≠ 0 фиксирует seed мира для тюнинга (в репозитории всегда 0).
-- Это параметр мира, а не презентация: единственное go.property на world.script.
go.property("debug_seed", 0)

local GEOM_CFG = "#geom_cfg"
local ANIM_CFG = "#anim_cfg"
local FLASH_CFG = "#flash_cfg"

-- Вид хода -> роль палитры для рамки карты — в scripts/view/board.lua (board.BORDER_KEY):
-- рамка карты и есть индикация хода, отдельных обводок вокруг клеток нет.

-- Чтение config-компонентов один раз при старте. Значения go.property — константы сборки,
-- порядок init владельца не важен (docs/DEFOLD_INTEGRATION.md §4.2).
local function read_config(self)
	self.cell_gap = go.get(GEOM_CFG, "cell_gap")
	self.card_border = go.get(GEOM_CFG, "card_border")
	self.dash_step = go.get(GEOM_CFG, "dash_step")
	self.dash_size = go.get(GEOM_CFG, "dash_size")
	self.move_ms = go.get(ANIM_CFG, "move_ms")
	self.fall_drop = go.get(ANIM_CFG, "fall_drop")
	self.popup_spread = go.get(ANIM_CFG, "popup_spread")
	self.popup_y_factor = go.get(ANIM_CFG, "popup_y_factor")
	self.color_flash = go.get(FLASH_CFG, "color_flash")
	self.flash_alpha = go.get(FLASH_CFG, "flash_alpha")
	self.flash_ms = go.get(FLASH_CFG, "flash_ms")
	-- Палитра здесь не читается: цвета живут в gui/palette.gui и приходят сообщением "palette"
	-- от palette.gui_script. До этого сообщения self.pal = nil, а refresh ничего не рисует.
end

-- Проверка связей style -> palette при старте (§5.6): неизвестная роль дала бы
-- тихий nil и падение в бою. Обязательная проверка; ненайденная роль — остановка.
local function check_palette(self)
	local function need(desc, key)
		if self.pal[key] == nil then
			error("палитра: нет цвета '" .. key .. "' (нужен для " .. desc .. ")")
		end
	end
	for _, key in ipairs(palette.KEYS) do
		need("полного набора scripts/view/palette.lua", key)
	end
	for type_, view in pairs(style) do
		local fill, ink = palette.roles(view.skin)
		need("fill " .. type_, fill)
		need("ink " .. type_, ink)
	end
	for _, key in pairs(board.BORDER_KEY) do
		need("рамка хода", key)
	end
	need("dot", "dot")
	need("vision", "vision")
	need("spotted", "spotted")
end

local function has_event(events, type_)
	for _, e in ipairs(events) do
		if e.type == type_ then
			return true
		end
	end
	return false
end

-- Ряды, карты и акторы — в scripts/view/board.lua; эфемерные ГО — в scripts/view/fx.lua.

-- Нижний ряд арены (ряд игрока): ряд типа boss с остатком периода (PERIOD - ARENA_ROWS).
local PERIOD = balance.boss.period
local ARENA_ROWS = balance.boss.arenaRows

local function is_arena_bottom(y)
	return arena.arena_bottom_for_row(y) == y
end

-- Состояние боя создаётся заранее, как только любой ряд арены появился в поле зрения.
-- Карты при этом уже лежат на обоих рядах, а босс виден на своей колонке ещё до входа.
local function create_arena(self, bottom)
	local boss_number = (bottom + ARENA_ROWS) / PERIOD
	local g = rng.new(row_seed.row_seed(self.seed, self.world.respawn_count, bottom))
	local frac = self.player.hp / self.player.max_hp
	local pr, br = arena.generate_rows(g, arena.player_row_chances(frac))
	self.arena = arena.new(self.world.pos.x, self.player.hp, self.player.max_hp,
		boss_number, pr, br, g)
	self.arena_bottom = bottom
end

local function ensure_arena_preview(self)
	if self.arena ~= nil or self.world.mode ~= MODES.WORLD then
		return
	end
	for _, y in ipairs(layout.visible_rows(self.world.pos.y)) do
		local bottom = arena.arena_bottom_for_row(y)
		if bottom ~= nil then
			create_arena(self, bottom)
			return
		end
	end
end

-- Перерисовка: доска (контейнер, карты, акторы, рамки ходов, очистка fx), затем пунктир.
local function refresh(self)
	if self.pal == nil then
		return -- палитра ещё не пришла от gui/palette.gui (первый кадр)
	end
	ensure_arena_preview(self)
	local pr = self.world.pos.y
	board.refresh(self)
	-- Слой угроз: поверх клеток, под персонажами и содержимым (GDD §5.4).
	for _, y in ipairs(layout.visible_rows(pr)) do
		local row = board.content_row(self, y)
		local vision_row = highlight.vision(row, y)
		local cy = layout.world_center(y)
		local h = layout.row_height(y)
		for x = 0, layout.COLUMNS - 1 do
			local alpha = highlight.vision_alpha(vision_row[x])
			if alpha ~= nil then
				-- Оверлей ужимается на толщину рамки карты: подсветка закрывает подложку,
				-- но не рамку — иначе индикация хода пропадала бы под плотным слоем.
				local inset = board.cell_inset(self, x, y)
				if y == pr and x == self.world.pos.x and self.world.mode == MODES.WORLD then
					-- Игрок в поле зрения: его клетка красная, над заливкой клетки и под картой персонажа.
					fx.threat(self, layout.cell_x(x), cy, h, self.pal.spotted, alpha, Z_SPOTTED, inset)
				else
					fx.threat(self, layout.cell_x(x), cy, h, self.pal.vision, alpha, Z_THREAT, inset)
				end
			end
		end
	end
	-- Индикация хода — рамки карт, их ставит board.refresh по board.update_moves.
	-- Здесь остаётся только пунктир выстрела: белый, самый верхний слой.
	local reach = registry.equipment.CROSSBOW.range
	if self.world.mode == MODES.WORLD then
		local py = layout.world_center(pr)
		for _, x in ipairs(highlight.shot_targets(self.world.pos, board.get_row(self, pr), self.player.weapon, reach)) do
			fx.dashed(self, layout.cell_x(self.world.pos.x), py, layout.cell_x(x), py)
		end
	elseif self.world.mode == MODES.BOSS and self.arena ~= nil then
		-- Пунктир выстрела по боссу.
		local a = self.arena
		local boss_x = highlight.arena_shot(a, self.player.weapon, reach)
		if boss_x ~= nil then
			fx.dashed(self, layout.cell_x(a.player_x), layout.world_center(pr),
				layout.cell_x(boss_x), layout.world_center(pr + 1))
		end
	end
end

-- ================= Анимации =================

-- Раннер таймлайна и ожидание "anim_done" — в scripts/view/timeline.lua.
-- on_palette объявлен ниже: finish_view определён после on_message.
local on_palette

function on_message(self, message_id, message, sender)
	if message_id == hash("palette") then
		on_palette(self, message)
		return
	end
	timeline.on_message(self, message_id, message, sender)
end

-- Таймлайн перемещения: карта игрока приподнимается, летит в новую клетку, контейнер рядов
-- скроллится одновременно с ней; старт и финиш совпадают (move_ms).
local function play_move(self, from_x, from_y, to_x, to_y, done)
	if self.player_go == nil then
		done()
		return
	end
	local move_s = self.move_ms / 1000
	-- Новые ряды создаём до прокрутки, чтобы они выезжали из-под фейдов.
	ensure_arena_preview(self)
	for _, y in ipairs(layout.visible_rows(to_y)) do
		board.ensure_row(self, y)
	end
	go.cancel_animations(self.player_go, "position")
	go.cancel_animations(self.rows_id, "position")
	go.set(self.player_go, "position",
		vmath.vector3(layout.cell_x(from_x), layout.world_center(from_y), board.Z_ACTOR))
	go.set(self.rows_id, "position", vmath.vector3(0, layout.container_y(from_y), 0))
	local pending = 2
	local function finish()
		pending = pending - 1
		if pending == 0 then
			done()
		end
	end
	msg.post(self.player_go, "lift", { duration = move_s / 2 })
	go.animate(self.player_go, "position", go.PLAYBACK_ONCE_FORWARD,
		vmath.vector3(layout.cell_x(to_x), layout.world_center(to_y), board.Z_ACTOR),
		go.EASING_INOUTQUAD, move_s, 0, finish)
	go.animate(self.rows_id, "position", go.PLAYBACK_ONCE_FORWARD,
		vmath.vector3(0, layout.container_y(to_y), 0),
		go.EASING_INOUTQUAD, move_s, 0, finish)
end

local function slide_step(self, from_x, from_y, to_x, to_y)
	return function(next)
		play_move(self, from_x, from_y, to_x, to_y, next)
	end
end

-- Падение поверженной карты: вниз с уходом в прозрачность (GDD §16, событие death/enemy_dead).
-- Длительность и цвет — свойства card.script; offset считается от высоты ряда.
local function fall_message(self, id, y)
	msg.post(id, "fall", {
		offset = vmath.vector3(0, -layout.row_height(y) * self.fall_drop, 0),
	})
end

-- ================= Таймлайны событий хода =================

-- run.step: атаки «в спину» (выпад врага к игроку, цифры на игроке), перемещение,
-- затем подбор (цифры на приземлении) или падение карты игрока при смерти.
local function steps_step(self, from_x, from_y, events)
	local steps = {}
	local behinds, move, gold, heal, died = {}, nil, nil, nil, false
	for _, e in ipairs(events) do
		if e.type == "behind_attack" then
			table.insert(behinds, e)
		elseif e.type == "move" then
			move = e
		elseif e.type == "gold" then
			gold = e
		elseif e.type == "heal" then
			heal = e
		elseif e.type == "death" then
			died = true
		end
	end
	if #behinds > 0 then
		-- Несколько врагов бьют «в спину» последовательно: выпад, цифра, вспышка — на каждого.
		for i, e in ipairs(behinds) do
			table.insert(steps, timeline.card_anim(self, board.card_id_at(self, e.enemy_x, from_y), "lunge", {
				offset = board.lunge_offset(e.enemy_x, from_y, from_x, from_y, 0.6),
			}))
			local dx = (i - 1) * self.popup_spread - self.popup_spread / 2
			table.insert(steps, function(next)
				fx.popup(self, from_x, from_y, "-" .. e.damage, "damage", dx)
				hud.flash(self)
				next()
			end)
		end
	end
	if died then
		table.insert(steps, function(next)
			hud.flash(self)
			next()
		end)
		table.insert(steps, timeline.card_anim(self, self.player_go, "fall", {
			offset = vmath.vector3(0, -layout.row_height(from_y) * self.fall_drop, 0),
		}))
		return steps
	end
	if move ~= nil then
		table.insert(steps, slide_step(self, from_x, from_y, self.world.pos.x, self.world.pos.y))
	end
	if gold ~= nil or heal ~= nil then
		local lx, ly = self.world.pos.x, self.world.pos.y
		table.insert(steps, function(next)
			if heal ~= nil then
				fx.popup(self, lx, ly, "+" .. heal.amount, "heal", 0)
			end
			if gold ~= nil then
				fx.popup(self, lx, ly, "+" .. gold.amount, "gold", self.popup_spread)
			end
			next()
		end)
	end
	return steps
end

-- run.melee: выпад игрока к карте врага, возврат-отскок, цифры урона с обеих карт,
-- падение карты врага, переход на её клетку; при гибели игрока падает его карта.
local function steps_melee(self, from_x, from_y, tx, ty, events)
	local steps = {}
	local poke, dead, died
	for _, e in ipairs(events) do
		if e.type == "poke" then
			poke = e
		elseif e.type == "enemy_dead" then
			dead = e
		elseif e.type == "death" then
			died = true
		end
	end
	if poke == nil then
		return steps
	end
	local player_card = self.player_go
	local enemy_card = board.card_id_at(self, tx, ty)
	table.insert(steps, timeline.card_anim(self, player_card, "lunge", {
		offset = board.lunge_offset(from_x, from_y, tx, ty, 0.6),
	}))
	table.insert(steps, function(next)
		-- Отскок завершён: цифры урона, мигание экрана (урон по игроку), поверженный враг падает.
		fx.popup(self, tx, ty, "-" .. poke.dealt_to_enemy, "damage", 0)
		fx.popup(self, from_x, from_y, "-" .. poke.dealt_to_player, "damage", self.popup_spread)
		hud.flash(self)
		if dead ~= nil then
			if enemy_card ~= nil then
				fall_message(self, enemy_card, ty)
			end
			table.insert(steps, slide_step(self, from_x, from_y, tx, ty))
		else
			table.insert(steps, timeline.card_anim(self, player_card, "fall", {
				offset = vmath.vector3(0, -layout.row_height(from_y) * self.fall_drop, 0),
			}))
		end
		next()
	end)
	return steps
end

-- run.shoot: цифры урона, белая вспышка карты врага (GDD §16), падение при гибели.
local function steps_shoot(self, x, events)
	local steps = {}
	local shot, dead
	for _, e in ipairs(events) do
		if e.type == "shot" then
			shot = e
		elseif e.type == "enemy_dead" then
			dead = e
		end
	end
	if shot == nil then
		return steps
	end
	local y = self.world.pos.y
	local id = board.card_id_at(self, x, y)
	table.insert(steps, function(next)
		fx.popup(self, x, y, "-" .. shot.damage, "damage", 0)
		next()
	end)
	table.insert(steps, timeline.card_anim(self, id, "flash", {}))
	if dead ~= nil and id ~= nil then
		table.insert(steps, function(next)
			fall_message(self, id, y)
			next()
		end)
	end
	return steps
end

-- Арена: слайд игрока по своему ряду, атака клеткой — выпад к боссу и цифры на нём;
-- ход босса — выпад к игроку и цифры на игроке; победа — прыжок на чекпоинт;
-- поражение — падение карты игрока.
local function steps_arena(self, from_x, from_y, mid_x, boss_from_x, boss_to_x, events, outcome, win_target)
	local steps = {}
	table.insert(steps, slide_step(self, from_x, from_y, mid_x, from_y))
	local pattack, battack, heal
	for _, e in ipairs(events) do
		if e.type == "player_attack" then
			pattack = e
		elseif e.type == "boss_attack" then
			battack = e
		elseif e.type == "heal" then
			heal = e
		end
	end
	if pattack ~= nil then
		table.insert(steps, timeline.card_anim(self, self.player_go, "lunge", {
			offset = board.lunge_offset(mid_x, from_y, boss_from_x, from_y + 1, 0.55),
		}))
		table.insert(steps, function(next)
			fx.popup(self, boss_from_x, from_y + 1, "-" .. pattack.damage, "damage", 0)
			next()
		end)
	end
	if heal ~= nil then
		table.insert(steps, function(next)
			fx.popup(self, mid_x, from_y, "+" .. balance.cells.HEAL.amount, "heal", 0)
			next()
		end)
	end
	if battack ~= nil then
		if boss_to_x ~= boss_from_x then
			-- Сначала босс переезжает в новую колонку, потом бьёт оттуда.
			table.insert(steps, function(next)
				local id = self.boss_go
				if id == nil then
					next()
					return
				end
				go.animate(id, "position", go.PLAYBACK_ONCE_FORWARD,
					vmath.vector3(layout.cell_x(boss_to_x), layout.world_center(from_y + 1), board.Z_ACTOR),
					go.EASING_INOUTQUAD, self.move_ms / 1000, 0, next)
			end)
		end
		table.insert(steps, timeline.card_anim(self, self.boss_go, "lunge", {
			offset = board.lunge_offset(boss_to_x, from_y + 1, mid_x, from_y, 0.55),
		}))
		table.insert(steps, function(next)
			fx.popup(self, mid_x, from_y, "-" .. battack.damage, "damage", 0)
			hud.flash(self)
			if outcome == "defeat" then
				table.insert(steps, timeline.card_anim(self, self.player_go, "fall", {
					offset = vmath.vector3(0, -layout.row_height(from_y) * self.fall_drop, 0),
				}))
			end
			next()
		end)
	end
	if outcome == "victory" and win_target ~= nil then
		table.insert(steps, slide_step(self, mid_x, from_y, win_target.x, win_target.y))
	end
	return steps
end

-- Эффект стартовой клетки при входе на арену: показывается после слайда игрока.
local function steps_arena_entry(self, x, y, events)
	local steps = {}
	local pattack, heal
	for _, e in ipairs(events) do
		if e.type == "player_attack" then
			pattack = e
		elseif e.type == "heal" then
			heal = e
		end
	end
	if pattack ~= nil then
		local boss_x = self.arena.boss_x
		table.insert(steps, timeline.card_anim(self, self.player_go, "lunge", {
			offset = board.lunge_offset(x, y, boss_x, y + 1, 0.55),
		}))
		table.insert(steps, function(next)
			fx.popup(self, boss_x, y + 1, "-" .. pattack.damage, "damage", 0)
			next()
		end)
	end
	if heal ~= nil then
		table.insert(steps, function(next)
			fx.popup(self, x, y, "+" .. balance.cells.HEAL.amount, "heal", 0)
			next()
		end)
	end
	return steps
end

-- Арена: выстрел по боссу — вспышка его карты и цифры; победа — прыжок на чекпоинт.
local function steps_arena_shot(self, boss_x, row, shot, won, win_target)
	local steps = {}
	if shot ~= nil then
		table.insert(steps, function(next)
			fx.popup(self, boss_x, row + 1, "-" .. shot.damage, "damage", 0)
			next()
		end)
		table.insert(steps, timeline.card_anim(self, self.boss_go, "flash", {}))
	end
	if won and win_target ~= nil then
		table.insert(steps, slide_step(self, self.world.pos.x, row, win_target.x, win_target.y))
	end
	return steps
end

-- Синхронизация экрана по завершении таймлайна.
local function finish_view(self)
	hud.sync(self)
	refresh(self)
end

-- "palette" от gui/palette.gui: цвета правятся пикером в GUI-редакторе. До сообщения
-- refresh не рисует поле; после — первая отрисовка (см. init: finish_view вызывается сразу,
-- но refresh ждёт палитру).
on_palette = function(self, message)
	self.pal = message.colors
	check_palette(self)
	finish_view(self)
end

-- Клетки ряда точки возврата сохраняются целиком: этот ряд не пересоздаётся между сессиями.
local function return_point_for_save(self)
	local rp = self.world.return_point
	local out = { kind = rp.kind, row = rp.row, x = rp.x }
	local cells = board.get_row(self, rp.row)
	out.cells = {}
	for x = 0, layout.COLUMNS - 1 do
		out.cells[x + 1] = (cells[x] or { type = "EMPTY" }).type
	end
	return out
end

local function save(self)
	saves.write({
		version = save_schema.SCHEMA_VERSION,
		gold = self.player.gold,
		upgrades = self.upgrades,
		return_point = return_point_for_save(self),
	})
end

-- Смерть: переход в DEATH, оверлей. Возврат — по нажатию.
local function apply_events(self, events)
	for _, e in ipairs(events) do
		if e.type == "death" then
			print("DEATH at row " .. self.world.pos.y)
			self.arena = nil
			self.arena_bottom = nil
			world.transition(self.world, MODES.DEATH)
		elseif e.type == "refused" then
			print("refused: " .. e.reason)
		end
	end
end

local function respawn(self)
	local player, lost = death.respawn(self.player, self.world.return_point.kind)
	if player == nil then
		print(lost)
		return
	end
	self.player = player
	self.run.player = player
	self.arena = nil
	self.arena_bottom = nil
	world.respawn(self.world)
	-- Ряды выше точки возврата генерируются заново с новым respawn_count (GDD §11).
	local rp_row = self.world.return_point.row
	local stale = {}
	for y in pairs(self.rows) do
		if y > rp_row then
			table.insert(stale, y)
		end
	end
	for _, y in ipairs(stale) do
		self.rows[y] = nil
	end
	print("respawn at " .. self.world.return_point.kind .. ", gold lost: " .. lost)
	save(self)
	finish_view(self)
end

local function make_camp(self)
	local pos = self.world.pos
	local cells = board.get_row(self, pos.y)
	local res, reason = camp.install(self.camp_state, self.player.gold, cells)
	if res == nil then
		print(reason)
		return
	end
	for x = 0, layout.COLUMNS - 1 do
		cells[x] = res.cells[x]
	end
	self.player.gold = res.gold
	world.set_return_point(self.world, "camp", pos.y, pos.x)
	world.transition(self.world, MODES.CAMP)
	self.player.hp = self.player.max_hp
	equipment.restore(self.player.weapon)
	save(self)
	finish_view(self)
end

local function leave_camp(self)
	camp.exit(self.camp_state)
	world.transition(self.world, MODES.WORLD)
	save(self)
	hud.sync(self)
end

-- Вход на арену: preview уже создан при появлении арены в поле зрения; здесь он
-- актуализируется по текущей позиции и HP игрока. Если preview не было — создаём.
local function enter_arena(self)
	local pos = self.world.pos
	if self.arena == nil or self.arena_bottom ~= pos.y then
		create_arena(self, pos.y)
	end
	local a = self.arena
	a.player_x = pos.x
	a.player_hp = self.player.hp
	a.player_max = self.player.max_hp
	a.turn = "player"
	a.prev_boss_x = nil
	a.fired = false
	-- Флаг «уже стрелял на ряду» — механика мира; в арене свой лимит (a.fired).
	-- Сбрасываем при входе, чтобы выстрел был доступен с первого хода боя (GDD §12.2).
	equipment.new_row(self.player.weapon)
	world.transition(self.world, MODES.BOSS)
	local entry_events = arena.trigger_player_cell(a, a.player_x)
	self.player.hp = a.player_hp
	local boss_number = (pos.y + ARENA_ROWS) / PERIOD
	print("arena " .. boss_number .. " started at row " .. pos.y)
	return entry_events
end

-- Исход боя: победа — чекпоинт выше арены, поражение — смерть.
local function arena_outcome(self)
	local res = arena.result(self.arena)
	if res == "victory" then
		world.boss_victory(self.world)
		self.arena = nil
		self.arena_bottom = nil
		print("boss defeated, checkpoint at row " .. self.world.pos.y)
		save(self)
	elseif res == "defeat" then
		self.player.hp = 0
		self.arena = nil
		self.arena_bottom = nil
		world.transition(self.world, MODES.DEATH)
		print("defeated by boss")
	end
	return res
end

-- Ход в бою: перемещение или атака клеткой, затем ход босса (если бой продолжается).
local function arena_move(self, x)
	local a = self.arena
	local from_x = a.player_x
	local from_y = self.world.pos.y
	local boss_from_x = a.boss_x
	local ok, events = arena.player_move(a, x)
	if not ok then
		print("refused: " .. events)
		return
	end
	local boss_to_x = boss_from_x
	if arena.result(a) == nil then
		local boss_events = arena.boss_turn(a)
		for _, e in ipairs(boss_events) do
			table.insert(events, e)
			if e.type == "boss_move" then
				boss_to_x = e.x
			end
		end
	end
	-- Завершённый ход игрока в арене, как в мире: тикает таймер перезарядки (GDD §7).
	equipment.tick(self.player.weapon)
	self.player.hp = a.player_hp
	self.world.pos.x = a.player_x
	local outcome = arena_outcome(self)
	local win_target = nil
	if outcome == "victory" then
		win_target = { x = self.world.pos.x, y = self.world.pos.y }
	end
	local steps = steps_arena(self, from_x, from_y, self.world.pos.x, boss_from_x, boss_to_x,
		events, outcome, win_target)
	if #steps == 0 then
		finish_view(self)
	else
		timeline.play(self, steps, function()
			finish_view(self)
		end)
	end
end

local function arena_shoot(self)
	local a = self.arena
	local row = self.world.pos.y
	local boss_x = a.boss_x
	local range = registry.equipment.CROSSBOW.range
	local ok, res = arena.shoot(a, self.player.weapon, self.player.weapon_damage, range)
	if not ok then
		print("refused: " .. tostring(res))
		return
	end
	local won = arena.result(a) == "victory"
	local win_target = nil
	if won then
		arena_outcome(self)
		win_target = { x = self.world.pos.x, y = self.world.pos.y }
	end
	local steps = steps_arena_shot(self, boss_x, row, res[1], won, win_target)
	if #steps == 0 then
		finish_view(self)
	else
		timeline.play(self, steps, function()
			finish_view(self)
		end)
	end
end

-- Ход на клетку / бой / выстрел только в режиме WORLD.
local function world_action(self, action_type, x, row)
	local from_x = self.world.pos.x
	local from_y = self.world.pos.y
	-- Шаг на нижний ряд арены: обычный ход (включая атаки в спину), но клетку входа
	-- обрабатывает арена, а не interact мира.
	if action_type == "step" and is_arena_bottom(row) then
		local ok, events = run.step(self.run, x, row, { arena_entry = true })
		apply_events(self, events)
		if not ok then
			return
		end
		local moved = has_event(events, "move")
		local entry_events
		if moved then
			self.player.gold, _ = camp.tick_payment(self.camp_state, self.player.gold)
			entry_events = enter_arena(self)
		end
		local steps = {}
		if ok then
			steps = steps_step(self, from_x, from_y, events)
		end
		if entry_events ~= nil then
			for _, step in ipairs(steps_arena_entry(self, x, row, entry_events)) do
				table.insert(steps, step)
			end
		end
		if #steps == 0 then
			finish_view(self)
		else
			timeline.play(self, steps, function()
				finish_view(self)
			end)
		end
		return
	end
	local ok, events, entry_events
	if action_type == "step" then
		ok, events = run.step(self.run, x, row)
	elseif action_type == "melee" then
		ok, events = run.melee(self.run, x, row)
	else
		ok, events = run.shoot(self.run, x)
	end
	apply_events(self, events)
	local moved = ok and has_event(events, "move")
	if moved then
		self.player.gold, _ = camp.tick_payment(self.camp_state, self.player.gold)
		local pos = self.world.pos
		if row_gen.kind(pos.y) == "checkpoint" and pos.y > self.world.return_point.row then
			world.set_return_point(self.world, "checkpoint", pos.y, pos.x)
			save(self)
		end
		if is_arena_bottom(pos.y) then
			entry_events = enter_arena(self)
		end
	end
	local steps = {}
	if ok then
		if action_type == "melee" then
			steps = steps_melee(self, from_x, from_y, x, row, events)
		elseif action_type == "step" then
			steps = steps_step(self, from_x, from_y, events)
		else
			steps = steps_shoot(self, x, events)
		end
	end
	if entry_events ~= nil then
		for _, step in ipairs(steps_arena_entry(self, x, row, entry_events)) do
			table.insert(steps, step)
		end
	end
	if #steps == 0 then
		finish_view(self)
	else
		timeline.play(self, steps, function()
			finish_view(self)
		end)
	end
end

function init(self)
	read_config(self)
	-- check_palette — не здесь: палитра приходит сообщением "palette" (on_palette).
	msg.post(".", "acquire_input_focus")
	self.rows_id = go.get_id("rows")
	local data, found = saves.load()
	-- Новый мир при каждом запуске (GDD §18); debug_seed ≠ 0 фиксирует seed для тюнинга.
	-- В репозитории debug_seed всегда 0: ненулевое значение в коммите = зафиксированный мир у всех.
	-- Из сохранения живут только золото, прокачка и точка возврата.
	if self.debug_seed ~= 0 then
		self.seed = self.debug_seed
	else
		self.seed = math.floor((os.time() + os.clock()) * 1000) % 2147483647
	end
	self.upgrades = data.upgrades
	self.camp_state = camp.new_state()
	self.rows = {}
	self.cards = {}
	self.fx = {}
	self.pal = nil -- придёт сообщением "palette" от gui/palette.gui
	self.input_locked = false
	self.anim_waiters = {}
	self.anim_token = 0
	self.player_go = nil
	self.boss_go = nil
	self.arena = nil
	self.arena_bottom = nil
	self.world = world.new(self.seed, 0)
	if found then
		local rp = data.return_point
		self.world.return_point = { kind = rp.kind, row = rp.row, x = rp.x }
		self.world.pos = { x = rp.x, y = rp.row }
		if rp.cells then
			-- Ряд точки возврата восстанавливается из сохранения, а не из генератора.
			local cells = {}
			for x = 0, layout.COLUMNS - 1 do
				cells[x] = { type = rp.cells[x + 1] }
			end
			self.rows[rp.row] = cells
		end
	end
	local stats = upgrades.stats({ levels = self.upgrades })
	self.player = {
		hp = stats.max_hp,
		max_hp = stats.max_hp,
		gold = data.gold,
		weapon = equipment.new(stats.max_charges, balance.player.weapon.rechargeTurns),
		weapon_damage = stats.weapon_damage,
	}
	self.run = {
		world = self.world,
		player = self.player,
		get_row = function(y)
			return board.get_row(self, y)
		end,
	}
	if not found then
		save(self)
	end
	finish_view(self)
end

function final(self)
	for _, row in pairs(self.cards) do
		for _, card in pairs(row) do
			go.delete(card.id)
		end
	end
	for _, id in ipairs(self.fx) do
		go.delete(id)
	end
	if self.player_go ~= nil then
		go.delete(self.player_go)
	end
	if self.boss_go ~= nil then
		go.delete(self.boss_go)
	end
	save(self)
end

local function design_point(px, py)
	local ok_size, width, height = pcall(window.get_size)
	if not ok_size or type(width) ~= "number" or type(height) ~= "number" then
		return nil
	end
	local safe = nil
	local ok_safe, area = pcall(window.get_safe_area)
	if ok_safe and type(area) == "table" then
		safe = area
	end
	local fit = layout.screen_fit(width, height, safe)
	return layout.screen_to_design(px, py, fit)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return false
	end
	if self.input_locked then
		return true
	end
	local mode = self.world.mode
	if mode == MODES.DEATH then
		respawn(self)
		return true
	end
	-- action.x/y уже растянуты в виртуальные 720x1560; для content-fit нужны
	-- реальные координаты окна, иначе тап смещается по вертикали/горизонтали.
	local px, py = design_point(action.screen_x, action.screen_y)
	if px == nil then
		return true
	end
	if py < BUTTON_HEIGHT then
		if mode == MODES.WORLD then
			make_camp(self)
		elseif mode == MODES.CAMP then
			leave_camp(self)
		end
		return true
	end
	local x, row = layout.cell_at(px, py, self.world.pos.y)
	if x == nil then
		return true
	end
	if mode == MODES.BOSS and self.arena then
		local pr = self.world.pos.y
		if row == pr and x ~= self.arena.player_x then
			arena_move(self, x)
		elseif row == pr + 1 and x == self.arena.boss_x then
			arena_shoot(self)
		end
		return true
	end
	if mode ~= MODES.WORLD then
		return true
	end
	local target = (board.get_row(self, row) or {})[x]
	if row == self.world.pos.y + 1 and target and target.type == "ENEMY" then
		world_action(self, "melee", x, row)
	elseif row == self.world.pos.y + 1 then
		world_action(self, "step", x, row)
	elseif row == self.world.pos.y and target and target.type == "ENEMY" then
		world_action(self, "shoot", x, row)
	end
	return true
end

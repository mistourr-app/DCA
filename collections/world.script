-- Скрипт мира: связка core/* с экраном (docs/ARCHITECTURE.md §5, §9).
-- Вся логика — в core/. Здесь: прокрутка ряда, карты клеток, тап, лагерь, смерть, сохранение
-- и проигрывание событий ядра (этап C: выпады, падение карт, всплывающие цифры).
-- Клетки — персистентные объекты в контейнере rows: diff-синхронизация по содержимому.
-- Логика не ждёт анимацию: события применяются сразу, экран проигрывает таймлайн,
-- ввод блокирован до его конца, финальная синхронизация вью — в done.
-- Все тексты на экране — английские (docs/CONVENTIONS.md §1).

local run = require("core.run")
local world = require("core.world")
local row_gen = require("core.row_gen")
local layout = require("core.layout")
local equipment = require("core.equipment")
local death = require("core.death")
local camp = require("core.camp")
local upgrades = require("core.upgrades")
local save_schema = require("core.save_schema")
local registry = require("core.registry.init")
local balance = require("core.data.balance")
local saves = require("scripts.saves")
local arena = require("core.arena")
local highlight = require("core.highlight")
local rng = require("core.rng")
local row_seed = require("core.row_seed")
local style = require("scripts.view.style")

local MODES = world.MODES
local BUTTON_HEIGHT = layout.MARGIN_BOTTOM

-- Слои отрисовки (position.z). Default-камера Defold рендерит только z в [-1..1], вне диапазона
-- объект молча не рисуется; больше z = ближе к камере; равный z = порядок не определён.
-- label в cell.go поднят на +0.2 внутри GO: «содержимое» клетки остаётся поверх слоя угроз.
-- Клетки < слой угроз < персонажи < красный «вас видят» < обводки < пунктир < цифры.
local Z_CELL = 0
local Z_THREAT = 0.1
local Z_ACTOR = 0.3
local Z_SPOTTED = 0.4
local Z_OUTLINE = 0.6
local Z_DASH = 0.7
local Z_POPUP = 0.8

-- Слой z — константы кода (порядок отрисовки, не настраиваемые данные).
-- Презентационные числа вынесены в config-скрипты на том же world.go
-- (docs/DEFOLD_INTEGRATION.md §5.2): geom_cfg, anim_cfg, flash_cfg, palette_cfg.
-- Значения читаются один раз в init (go.get) и живут в self.

-- debug_seed ≠ 0 фиксирует seed мира для тюнинга (в репозитории всегда 0).
-- Это параметр мира, а не презентация: единственное go.property на world.script.
go.property("debug_seed", 0)

local GEOM_CFG = "#geom_cfg"
local ANIM_CFG = "#anim_cfg"
local FLASH_CFG = "#flash_cfg"
local PALETTE_CFG = "#palette_cfg"

-- Роли палитры в palette_cfg (docs/DEFOLD_INTEGRATION.md §5.2, §5.4).
local PALETTE_KEYS = {
	"fill_neutral", "fill_wall", "fill_good", "fill_gold",
	"fill_danger", "fill_attack", "fill_camp", "fill_player",
	"ink_dark", "ink_light",
	"outline_step", "outline_jump", "outline_attack",
	"dot", "vision", "spotted",
}

-- Вид хода -> роль палитры для обводки.
local OUTLINE_KEY = {
	step = "outline_step", jump = "outline_jump", attack = "outline_attack",
}

-- Чтение config-компонентов один раз при старте. Значения go.property — константы сборки,
-- порядок init владельца не важен (docs/DEFOLD_INTEGRATION.md §4.2).
local function read_config(self)
	self.cell_gap = go.get(GEOM_CFG, "cell_gap")
	self.border_width = go.get(GEOM_CFG, "border_width")
	self.dash_step = go.get(GEOM_CFG, "dash_step")
	self.dash_size = go.get(GEOM_CFG, "dash_size")
	self.move_ms = go.get(ANIM_CFG, "move_ms")
	self.fall_drop = go.get(ANIM_CFG, "fall_drop")
	self.popup_spread = go.get(ANIM_CFG, "popup_spread")
	self.popup_y_factor = go.get(ANIM_CFG, "popup_y_factor")
	self.color_flash = go.get(FLASH_CFG, "color_flash")
	self.flash_alpha = go.get(FLASH_CFG, "flash_alpha")
	self.flash_ms = go.get(FLASH_CFG, "flash_ms")
	self.pal = {}
	for _, key in ipairs(PALETTE_KEYS) do
		self.pal[key] = go.get(PALETTE_CFG, key)
	end
end

-- Проверка связей style -> palette при старте (§5.6): неизвестная роль дала бы
-- тихий nil и падение в бою. Обязательная проверка; ненайденная роль — остановка.
local function check_palette(self)
	local function need(desc, key)
		if self.pal[key] == nil then
			error("palette_cfg: нет свойства " .. key .. " для " .. desc)
		end
	end
	for type_, view in pairs(style) do
		need("fill " .. type_, view.fill)
		need("ink " .. type_, view.ink)
	end
	for _, key in pairs(OUTLINE_KEY) do
		need("outline", key)
	end
	need("dot", "dot")
	need("vision", "vision")
	need("spotted", "spotted")
end

local function has_event(events, type_)
	for _, e in ipairs(events) do
		if e.type == type_ then
			return true
		end
	end
	return false
end

-- Клетки ряда y; ряд генерируется по seed при первом обращении и кэшируется.
local function get_row(self, y)
	if y < 0 then
		return nil
	end
	local cells = self.rows[y]
	if cells == nil then
		cells = row_gen.generate(self.seed, self.world.respawn_count, y).cells
		self.rows[y] = cells
	end
	return cells
end

-- Источник содержимого ряда на экране: в бою ряды берутся из состояния арены,
-- остальные — из генератора (ряды типа boss без боя пусты).
local function content_row(self, y)
	local a = self.arena
	if self.world.mode == MODES.BOSS and a ~= nil then
		local pr = self.world.pos.y
		if y == pr then
			return a.player_row
		end
		if y == pr + 1 then
			return a.boss_row
		end
	end
	return get_row(self, y)
end

-- Подпись содержимого клетки: меняется, когда нужно переслать "set".
local function cell_sig(cell)
	if cell.type == "ENEMY" then
		return "ENEMY:" .. tostring(cell.enemy) .. ":" .. tostring(cell.hp or "")
	end
	return cell.type
end

local function cell_view(self, cell)
	local view = style[cell.type] or style.EMPTY
	local text = view.symbol
	if cell.type == "ENEMY" then
		local t = registry.enemies.types[cell.enemy]
		text = t.label:sub(1, 1) .. tostring(cell.hp or t.base_hp)
	end
	return text, self.pal[view.fill], self.pal[view.ink]
end

local function card_msg(self, x, y, text, fill, ink)
	local h = layout.row_height(y)
	return { text = text, color = fill, text_color = ink,
		width = layout.CELL_W - self.cell_gap, height = h - self.cell_gap }
end

-- Клетка-карта в контейнере рядов: локальные координаты = пространство рядов.
local function create_card(self, x, y, z)
	local pos = vmath.vector3(layout.cell_x(x), layout.world_center(y), z)
	local id = factory.create("#cell_factory", pos)
	if id == nil then
		print("card create failed: label buffer full (raise [label] max_count in game.project)")
		return nil
	end
	go.set_parent(id, self.rows_id, false)
	return id
end

local function update_card(self, id, x, y, z, text, fill, ink)
	go.set(id, "position", vmath.vector3(layout.cell_x(x), layout.world_center(y), z))
	msg.post(id, "set", card_msg(self, x, y, text, fill, ink))
end

-- Прямоугольник без надписи (обводка, точка пунктира, оверлей угрозы). Эфемерный: в self.fx.
local function spawn_bar(self, cx, cy, w, h, color, z)
	local id = factory.create("#bar_factory", vmath.vector3(cx, cy, z))
	if id == nil then
		print("bar spawn failed: sprite buffer full (raise [sprite] max_count in game.project)")
		return
	end
	go.set_parent(id, self.rows_id, false)
	msg.post(id, "set", { width = w, height = h, color = color })
	table.insert(self.fx, id)
end

-- Обводка клетки: четыре полоски в зазоре между клетками. Координаты — пространство рядов.
local function draw_outline(self, cx, cy, w, h, color)
	local gap = self.cell_gap
	local border = self.border_width
	local ox = (w - gap) / 2 + border / 2
	local oy = (h - gap) / 2 + border / 2
	spawn_bar(self, cx, cy + oy, w, border, color, Z_OUTLINE)
	spawn_bar(self, cx, cy - oy, w, border, color, Z_OUTLINE)
	spawn_bar(self, cx - ox, cy, border, h, color, Z_OUTLINE)
	spawn_bar(self, cx + ox, cy, border, h, color, Z_OUTLINE)
end

-- Тонкая пунктирная линия от точки (ax, ay) до (bx, by), верхний слой. Пространство рядов.
local function draw_dashed(self, ax, ay, bx, by)
	for _, p in ipairs(highlight.dash_points(ax, ay, bx, by, self.dash_step)) do
		spawn_bar(self, p.x, p.y, self.dash_size, self.dash_size, self.pal.dot, Z_DASH)
	end
end

-- Оверлей угрозы поверх клетки: цвет с заданной непрозрачностью, в своём слое z.
local function draw_threat(self, cx, cy, h, color, alpha, z)
	spawn_bar(self, cx, cy, layout.CELL_W - self.cell_gap, h - self.cell_gap,
		vmath.vector4(color.x, color.y, color.z, alpha), z)
end

-- Всплывающая цифра над клеткой (x, y); kind — цвет из свойств popup.script,
-- dx — разброс при нескольких цифрах на одной клетке.
local function spawn_popup(self, x, y, text, kind, dx)
	local px = layout.cell_x(x) + (dx or 0)
	local py = layout.world_center(y) + layout.row_height(y) * self.popup_y_factor
	local id = factory.create("#popup_factory", vmath.vector3(px, py, Z_POPUP))
	if id == nil then
		print("popup create failed: label buffer full (raise [label] max_count in game.project)")
		return
	end
	go.set_parent(id, self.rows_id, false)
	msg.post(id, "show", { text = text, kind = kind })
end

-- id карты клетки (x, y) из последней синхронизации; nil — карты нет на экране.
local function card_id_at(self, x, y)
	local rowmap = self.cards[y]
	local card = rowmap and rowmap[x]
	if card == nil then
		return nil
	end
	return card.id
end

-- Смещение выпада: от центра клетки (x0, y0) в сторону (x1, y1), доля distance fraction.
local function lunge_offset(x0, y0, x1, y1, fraction)
	local dx = layout.cell_x(x1) - layout.cell_x(x0)
	local dy = layout.world_center(y1) - layout.world_center(y0)
	return vmath.vector3(dx * fraction, dy * fraction, 0)
end

-- Мигание экрана при уроне по игроку: параметры — свойства world (gui-скрипты без property).
local function hud_flash(self)
	msg.post("#hud", "flash", {
		color = self.color_flash,
		alpha = self.flash_alpha,
		duration = self.flash_ms / 1000,
	})
end

-- Нижний ряд арены (ряд игрока): ряд типа boss с остатком периода (PERIOD - ARENA_ROWS).
local PERIOD = balance.boss.period
local ARENA_ROWS = balance.boss.arenaRows

local function is_arena_bottom(y)
	return row_gen.kind(y) == "boss" and (y % PERIOD) == (PERIOD - ARENA_ROWS)
end

-- Diff-синхронизация видимых клеток: создаём новые, обновляем изменившиеся,
-- удаляем вышедшие из окна. Ряды ниже игрока не видны и не хранятся как объекты.
-- Смена содержимого сбрасывает позицию карты: анимации (fall/lunge) могли её сместить.
local function sync_cells(self, pr)
	local new_cards = {}
	for _, y in ipairs(layout.visible_rows(pr)) do
		local old = self.cards[y]
		local out = {}
		local row = content_row(self, y)
		for x = 0, layout.COLUMNS - 1 do
			local cell = (row and row[x]) or { type = "EMPTY" }
			local sig = cell_sig(cell)
			local card = old and old[x]
			if card == nil then
				local id = create_card(self, x, y, Z_CELL)
				if id ~= nil then
					local text, fill, ink = cell_view(self, cell)
					msg.post(id, "set", card_msg(self, x, y, text, fill, ink))
					card = { id = id, sig = sig }
				end
			elseif card.sig ~= sig then
				go.set(card.id, "position", vmath.vector3(layout.cell_x(x), layout.world_center(y), Z_CELL))
				local text, fill, ink = cell_view(self, cell)
				msg.post(card.id, "set", card_msg(self, x, y, text, fill, ink))
				card.sig = sig
			end
			out[x] = card
		end
		if old ~= nil then
			for x, card in pairs(old) do
				if out[x] == nil then
					go.delete(card.id)
				end
			end
		end
		new_cards[y] = out
	end
	-- строки, вышедшие из окна: удаляем карты целиком
	local stale = {}
	for y in pairs(self.cards) do
		if new_cards[y] == nil then
			table.insert(stale, y)
		end
	end
	for _, y in ipairs(stale) do
		for _, card in pairs(self.cards[y]) do
			go.delete(card.id)
		end
		self.cards[y] = nil
	end
	self.cards = new_cards
end

-- Карта игрока: один персистентный объект, занимает клетку под собой и стоит над слоем угроз.
local function sync_player(self, pr)
	local pos = self.world.pos
	if self.player_go == nil then
		self.player_go = create_card(self, pos.x, pr, Z_ACTOR)
	end
	if self.player_go == nil then
		return
	end
	go.set(self.player_go, "position",
		vmath.vector3(layout.cell_x(pos.x), layout.world_center(pr), Z_ACTOR))
	local view = style.PLAYER
	msg.post(self.player_go, "set",
		card_msg(self, pos.x, pr, view.symbol, self.pal[view.fill], self.pal[view.ink]))
end

-- Карта босса: отдельный объект на верхнем ряду арены; создаётся в бою, удаляется по его концу.
local function sync_boss(self, pr)
	local a = self.arena
	if self.world.mode ~= MODES.BOSS or a == nil then
		if self.boss_go ~= nil then
			go.delete(self.boss_go)
			self.boss_go = nil
		end
		return
	end
	local boss_y = pr + 1
	if self.boss_go == nil then
		self.boss_go = create_card(self, a.boss_x, boss_y, Z_ACTOR)
	end
	if self.boss_go == nil then
		return
	end
	local view = style.BOSS
	update_card(self, self.boss_go, a.boss_x, boss_y, Z_ACTOR,
		view.symbol .. tostring(a.boss_hp), self.pal[view.fill], self.pal[view.ink])
end

-- Перерисовка: прокрутка контейнера, diff клеток, персонажи, эфемерные подсветки.
local function refresh(self)
	local pr = self.world.pos.y
	go.set(self.rows_id, "position", vmath.vector3(0, layout.container_y(pr), 0))
	sync_cells(self, pr)
	sync_player(self, pr)
	sync_boss(self, pr)
	for _, id in ipairs(self.fx) do
		go.delete(id)
	end
	self.fx = {}
	-- Слой угроз: поверх клеток, под персонажами и содержимым (GDD §5.4).
	for _, y in ipairs(layout.visible_rows(pr)) do
		local vision_row = highlight.vision(content_row(self, y), y)
		local cy = layout.world_center(y)
		local h = layout.row_height(y)
		for x = 0, layout.COLUMNS - 1 do
			local alpha = highlight.vision_alpha(vision_row[x])
			if alpha ~= nil then
				if y == pr and x == self.world.pos.x and self.world.mode == MODES.WORLD then
					-- Игрок в поле зрения: его клетка красная, поверх спрайта персонажа, под надписью.
					draw_threat(self, layout.cell_x(x), cy, h, self.pal.spotted, alpha, Z_SPOTTED)
				else
					draw_threat(self, layout.cell_x(x), cy, h, self.pal.vision, alpha, Z_THREAT)
				end
			end
		end
	end
	local reach = registry.equipment.CROSSBOW.range
	if self.world.mode == MODES.WORLD then
		-- Подсветка ходов на следующий ряд (шаг, прыжок, атака по врагу).
		local up_y = pr + 1
		for _, m in ipairs(highlight.moves(self.world.pos, self.player.hp, get_row(self, up_y))) do
			draw_outline(self, layout.cell_x(m.x), layout.world_center(up_y),
				layout.CELL_W, layout.row_height(up_y), self.pal[OUTLINE_KEY[m.kind]])
		end
		-- Пунктир до каждой цели, в которую выстрел возможен.
		local py = layout.world_center(pr)
		for _, x in ipairs(highlight.shot_targets(self.world.pos, get_row(self, pr), self.player.weapon, reach)) do
			draw_dashed(self, layout.cell_x(self.world.pos.x), py, layout.cell_x(x), py)
		end
	elseif self.world.mode == MODES.BOSS and self.arena ~= nil then
		-- Подсветка ходов по X на ряду игрока и пунктир выстрела по боссу.
		local a = self.arena
		for _, m in ipairs(highlight.arena_moves(a)) do
			draw_outline(self, layout.cell_x(m.x), layout.world_center(pr),
				layout.CELL_W, layout.row_height(pr), self.pal[OUTLINE_KEY[m.kind]])
		end
		local boss_x = highlight.arena_shot(a, self.player.weapon, reach)
		if boss_x ~= nil then
			draw_dashed(self, layout.cell_x(a.player_x), layout.world_center(pr),
				layout.cell_x(boss_x), layout.world_center(pr + 1))
		end
	end
end

-- ================= Анимации =================

-- Таймлайн: последовательность шагов function(next). Ввод блокирован до конца; done — финал.
local function play_timeline(self, steps, done)
	self.anim_steps = steps
	self.anim_done = done
	self.input_locked = true
	local function advance()
		local f = table.remove(self.anim_steps, 1)
		if f == nil then
			self.input_locked = false
			self.anim_done()
			return
		end
		f(advance)
	end
	advance()
end

-- Шаги, которым нужен ответ карты, регистрируют продолжение по токену;
-- карта шлёт "anim_done" {token} в sender своего сообщения.
function on_message(self, message_id, message, sender)
	if message_id == hash("anim_done") and message.token ~= nil then
		local cont = self.anim_waiters[message.token]
		if cont ~= nil then
			self.anim_waiters[message.token] = nil
			cont()
		end
	end
end

-- Шаг: отправить карте анимационное сообщение и дождаться "anim_done".
-- Нет карты (вне экрана) — шаг проходит сразу.
local function card_anim(self, id, name, payload)
	return function(next)
		if id == nil then
			next()
			return
		end
		self.anim_token = self.anim_token + 1
		self.anim_waiters[self.anim_token] = next
		payload.token = self.anim_token
		msg.post(id, name, payload)
	end
end

-- Таймлайн перемещения: карта игрока приподнимается, летит в новую клетку, контейнер рядов
-- скроллится одновременно с ней; старт и финиш совпадают (move_ms).
local function play_move(self, from_x, from_y, to_x, to_y, done)
	if self.player_go == nil then
		done()
		return
	end
	local move_s = self.move_ms / 1000
	go.cancel_animations(self.player_go, "position")
	go.cancel_animations(self.rows_id, "position")
	go.set(self.player_go, "position",
		vmath.vector3(layout.cell_x(from_x), layout.world_center(from_y), Z_ACTOR))
	go.set(self.rows_id, "position", vmath.vector3(0, layout.container_y(from_y), 0))
	local pending = 2
	local function finish()
		pending = pending - 1
		if pending == 0 then
			done()
		end
	end
	msg.post(self.player_go, "lift", { duration = move_s / 2 })
	go.animate(self.player_go, "position", go.PLAYBACK_ONCE_FORWARD,
		vmath.vector3(layout.cell_x(to_x), layout.world_center(to_y), Z_ACTOR),
		go.EASING_INOUTQUAD, move_s, 0, finish)
	go.animate(self.rows_id, "position", go.PLAYBACK_ONCE_FORWARD,
		vmath.vector3(0, layout.container_y(to_y), 0),
		go.EASING_INOUTQUAD, move_s, 0, finish)
end

local function slide_step(self, from_x, from_y, to_x, to_y)
	return function(next)
		play_move(self, from_x, from_y, to_x, to_y, next)
	end
end

-- Падение поверженной карты: вниз с уходом в прозрачность (GDD §16, событие death/enemy_dead).
-- Длительность и цвет — свойства cell.script; offset считается от высоты ряда.
local function fall_message(self, id, y)
	msg.post(id, "fall", {
		offset = vmath.vector3(0, -layout.row_height(y) * self.fall_drop, 0),
	})
end

-- ================= Таймлайны событий хода =================

-- run.step: атаки «в спину» (выпад врага к игроку, цифры на игроке), перемещение,
-- затем подбор (цифры на приземлении) или падение карты игрока при смерти.
local function steps_step(self, from_x, from_y, events)
	local steps = {}
	local behinds, move, gold, heal, died = {}, nil, nil, nil, false
	for _, e in ipairs(events) do
		if e.type == "behind_attack" then
			table.insert(behinds, e)
		elseif e.type == "move" then
			move = e
		elseif e.type == "gold" then
			gold = e
		elseif e.type == "heal" then
			heal = e
		elseif e.type == "death" then
			died = true
		end
	end
	if #behinds > 0 then
		-- Несколько врагов бьют «в спину» последовательно: выпад, цифра, вспышка — на каждого.
		for i, e in ipairs(behinds) do
			table.insert(steps, card_anim(self, card_id_at(self, e.enemy_x, from_y), "lunge", {
				offset = lunge_offset(e.enemy_x, from_y, from_x, from_y, 0.6),
			}))
			local dx = (i - 1) * self.popup_spread - self.popup_spread / 2
			table.insert(steps, function(next)
				spawn_popup(self, from_x, from_y, "-" .. e.damage, "damage", dx)
				hud_flash(self)
				next()
			end)
		end
	end
	if died then
		table.insert(steps, function(next)
			hud_flash(self)
			next()
		end)
		table.insert(steps, card_anim(self, self.player_go, "fall", {
			offset = vmath.vector3(0, -layout.row_height(from_y) * self.fall_drop, 0),
		}))
		return steps
	end
	if move ~= nil then
		table.insert(steps, slide_step(self, from_x, from_y, self.world.pos.x, self.world.pos.y))
	end
	if gold ~= nil or heal ~= nil then
		local lx, ly = self.world.pos.x, self.world.pos.y
		table.insert(steps, function(next)
			if heal ~= nil then
				spawn_popup(self, lx, ly, "+" .. heal.amount, "heal", 0)
			end
			if gold ~= nil then
				spawn_popup(self, lx, ly, "+" .. gold.amount, "gold", self.popup_spread)
			end
			next()
		end)
	end
	return steps
end

-- run.melee: выпад игрока к карте врага, возврат-отскок, цифры урона с обеих карт,
-- падение карты врага, переход на её клетку; при гибели игрока падает его карта.
local function steps_melee(self, from_x, from_y, tx, ty, events)
	local steps = {}
	local poke, dead, died
	for _, e in ipairs(events) do
		if e.type == "poke" then
			poke = e
		elseif e.type == "enemy_dead" then
			dead = e
		elseif e.type == "death" then
			died = true
		end
	end
	if poke == nil then
		return steps
	end
	local player_card = self.player_go
	local enemy_card = card_id_at(self, tx, ty)
	table.insert(steps, card_anim(self, player_card, "lunge", {
		offset = lunge_offset(from_x, from_y, tx, ty, 0.6),
	}))
	table.insert(steps, function(next)
		-- Отскок завершён: цифры урона, мигание экрана (урон по игроку), поверженный враг падает.
		spawn_popup(self, tx, ty, "-" .. poke.dealt_to_enemy, "damage", 0)
		spawn_popup(self, from_x, from_y, "-" .. poke.dealt_to_player, "damage", self.popup_spread)
		hud_flash(self)
		if dead ~= nil then
			if enemy_card ~= nil then
				fall_message(self, enemy_card, ty)
			end
			table.insert(steps, slide_step(self, from_x, from_y, tx, ty))
		else
			table.insert(steps, card_anim(self, player_card, "fall", {
				offset = vmath.vector3(0, -layout.row_height(from_y) * self.fall_drop, 0),
			}))
		end
		next()
	end)
	return steps
end

-- run.shoot: цифры урона, белая вспышка карты врага (GDD §16), падение при гибели.
local function steps_shoot(self, x, events)
	local steps = {}
	local shot, dead
	for _, e in ipairs(events) do
		if e.type == "shot" then
			shot = e
		elseif e.type == "enemy_dead" then
			dead = e
		end
	end
	if shot == nil then
		return steps
	end
	local y = self.world.pos.y
	local id = card_id_at(self, x, y)
	table.insert(steps, function(next)
		spawn_popup(self, x, y, "-" .. shot.damage, "damage", 0)
		next()
	end)
	table.insert(steps, card_anim(self, id, "flash", {}))
	if dead ~= nil and id ~= nil then
		table.insert(steps, function(next)
			fall_message(self, id, y)
			next()
		end)
	end
	return steps
end

-- Арена: слайд игрока по своему ряду, атака клеткой — выпад к боссу и цифры на нём;
-- ход босса — выпад к игроку и цифры на игроке; победа — прыжок на чекпоинт;
-- поражение — падение карты игрока.
local function steps_arena(self, from_x, from_y, mid_x, boss_from_x, boss_to_x, events, outcome, win_target)
	local steps = {}
	table.insert(steps, slide_step(self, from_x, from_y, mid_x, from_y))
	local pattack, battack, heal
	for _, e in ipairs(events) do
		if e.type == "player_attack" then
			pattack = e
		elseif e.type == "boss_attack" then
			battack = e
		elseif e.type == "heal" then
			heal = e
		end
	end
	if pattack ~= nil then
		table.insert(steps, card_anim(self, self.player_go, "lunge", {
			offset = lunge_offset(mid_x, from_y, boss_from_x, from_y + 1, 0.55),
		}))
		table.insert(steps, function(next)
			spawn_popup(self, boss_from_x, from_y + 1, "-" .. pattack.damage, "damage", 0)
			next()
		end)
	end
	if heal ~= nil then
		table.insert(steps, function(next)
			spawn_popup(self, mid_x, from_y, "+" .. balance.cells.HEAL.amount, "heal", 0)
			next()
		end)
	end
	if battack ~= nil then
		if boss_to_x ~= boss_from_x then
			-- Сначала босс переезжает в новую колонку, потом бьёт оттуда.
			table.insert(steps, function(next)
				local id = self.boss_go
				if id == nil then
					next()
					return
				end
				go.animate(id, "position", go.PLAYBACK_ONCE_FORWARD,
					vmath.vector3(layout.cell_x(boss_to_x), layout.world_center(from_y + 1), Z_ACTOR),
					go.EASING_INOUTQUAD, self.move_ms / 1000, 0, next)
			end)
		end
		table.insert(steps, card_anim(self, self.boss_go, "lunge", {
			offset = lunge_offset(boss_to_x, from_y + 1, mid_x, from_y, 0.55),
		}))
		table.insert(steps, function(next)
			spawn_popup(self, mid_x, from_y, "-" .. battack.damage, "damage", 0)
			hud_flash(self)
			if outcome == "defeat" then
				table.insert(steps, card_anim(self, self.player_go, "fall", {
					offset = vmath.vector3(0, -layout.row_height(from_y) * self.fall_drop, 0),
				}))
			end
			next()
		end)
	end
	if outcome == "victory" and win_target ~= nil then
		table.insert(steps, slide_step(self, mid_x, from_y, win_target.x, win_target.y))
	end
	return steps
end

-- Арена: выстрел по боссу — вспышка его карты и цифры; победа — прыжок на чекпоинт.
local function steps_arena_shot(self, boss_x, row, shot, won, win_target)
	local steps = {}
	if shot ~= nil then
		table.insert(steps, function(next)
			spawn_popup(self, boss_x, row + 1, "-" .. shot.damage, "damage", 0)
			next()
		end)
		table.insert(steps, card_anim(self, self.boss_go, "flash", {}))
	end
	if won and win_target ~= nil then
		table.insert(steps, slide_step(self, self.world.pos.x, row, win_target.x, win_target.y))
	end
	return steps
end

-- Текст HUD и кнопки внизу экрана.
local function sync_hud(self)
	local p = self.player
	local pos = self.world.pos
	local top = string.format("ROW %d   HP %d/%d   CHARGES %d/%d   GOLD %d",
		pos.y, p.hp, p.max_hp, p.weapon.charges, p.weapon.max_charges, p.gold)
	if self.camp_state.pay_turns_left > 0 then
		top = top .. string.format("   CAMP FEE: %d TURNS", self.camp_state.pay_turns_left)
	end
	local bottom
	if self.world.mode == MODES.CAMP then
		bottom = "LEAVE CAMP"
	elseif self.world.mode == MODES.WORLD then
		bottom = string.format("MAKE CAMP (%d gold)", camp.install_price(p.gold))
	elseif self.world.mode == MODES.BOSS and self.arena then
		bottom = string.format("BOSS HP %d/%d", self.arena.boss_hp, self.arena.boss_max)
	else
		bottom = ""
	end
	msg.post("#hud", "update", {
		top = top,
		bottom = bottom,
		overlay = self.world.mode == MODES.DEATH,
	})
end

-- Синхронизация экрана по завершении таймлайна.
local function finish_view(self)
	sync_hud(self)
	refresh(self)
end

-- Клетки ряда точки возврата сохраняются целиком: этот ряд не пересоздаётся между сессиями.
local function return_point_for_save(self)
	local rp = self.world.return_point
	local out = { kind = rp.kind, row = rp.row, x = rp.x }
	local cells = get_row(self, rp.row)
	out.cells = {}
	for x = 0, layout.COLUMNS - 1 do
		out.cells[x + 1] = (cells[x] or { type = "EMPTY" }).type
	end
	return out
end

local function save(self)
	saves.write({
		version = save_schema.SCHEMA_VERSION,
		gold = self.player.gold,
		upgrades = self.upgrades,
		return_point = return_point_for_save(self),
	})
end

-- Смерть: переход в DEATH, оверлей. Возврат — по нажатию.
local function apply_events(self, events)
	for _, e in ipairs(events) do
		if e.type == "death" then
			print("DEATH at row " .. self.world.pos.y)
			world.transition(self.world, MODES.DEATH)
		elseif e.type == "refused" then
			print("refused: " .. e.reason)
		end
	end
end

local function respawn(self)
	local player, lost = death.respawn(self.player, self.world.return_point.kind)
	if player == nil then
		print(lost)
		return
	end
	self.player = player
	self.run.player = player
	world.respawn(self.world)
	-- Ряды выше точки возврата генерируются заново с новым respawn_count (GDD §11).
	local rp_row = self.world.return_point.row
	local stale = {}
	for y in pairs(self.rows) do
		if y > rp_row then
			table.insert(stale, y)
		end
	end
	for _, y in ipairs(stale) do
		self.rows[y] = nil
	end
	print("respawn at " .. self.world.return_point.kind .. ", gold lost: " .. lost)
	save(self)
	finish_view(self)
end

local function make_camp(self)
	local pos = self.world.pos
	local cells = get_row(self, pos.y)
	local res, reason = camp.install(self.camp_state, self.player.gold, cells)
	if res == nil then
		print(reason)
		return
	end
	for x = 0, layout.COLUMNS - 1 do
		cells[x] = res.cells[x]
	end
	self.player.gold = res.gold
	world.set_return_point(self.world, "camp", pos.y, pos.x)
	world.transition(self.world, MODES.CAMP)
	self.player.hp = self.player.max_hp
	equipment.restore(self.player.weapon)
	save(self)
	finish_view(self)
end

local function leave_camp(self)
	camp.exit(self.camp_state)
	world.transition(self.world, MODES.WORLD)
	save(self)
	sync_hud(self)
end

-- Вход на арену: создаётся состояние боя, ряды арены генерируются по seed этого ряда.
local function enter_arena(self)
	local pos = self.world.pos
	local boss_number = (pos.y + ARENA_ROWS) / PERIOD
	local g = rng.new(row_seed.row_seed(self.seed, self.world.respawn_count, pos.y))
	local frac = self.player.hp / self.player.max_hp
	local pr, br = arena.generate_rows(g, arena.player_row_chances(frac))
	self.arena = arena.new(pos.x, self.player.hp, self.player.max_hp, boss_number, pr, br, g)
	-- Флаг «уже стрелял на ряду» — механика мира; в арене свой лимит (a.fired).
	-- Сбрасываем при входе, чтобы выстрел был доступен с первого хода боя (GDD §12.2).
	equipment.new_row(self.player.weapon)
	world.transition(self.world, MODES.BOSS)
	print("arena " .. boss_number .. " started at row " .. pos.y)
end

-- Исход боя: победа — чекпоинт выше арены, поражение — смерть.
local function arena_outcome(self)
	local res = arena.result(self.arena)
	if res == "victory" then
		world.boss_victory(self.world)
		self.arena = nil
		print("boss defeated, checkpoint at row " .. self.world.pos.y)
		save(self)
	elseif res == "defeat" then
		self.player.hp = 0
		self.arena = nil
		world.transition(self.world, MODES.DEATH)
		print("defeated by boss")
	end
	return res
end

-- Ход в бою: перемещение или атака клеткой, затем ход босса (если бой продолжается).
local function arena_move(self, x)
	local a = self.arena
	local from_x = a.player_x
	local from_y = self.world.pos.y
	local boss_from_x = a.boss_x
	local ok, events = arena.player_move(a, x)
	if not ok then
		print("refused: " .. events)
		return
	end
	local boss_to_x = boss_from_x
	if arena.result(a) == nil then
		local boss_events = arena.boss_turn(a)
		for _, e in ipairs(boss_events) do
			table.insert(events, e)
			if e.type == "boss_move" then
				boss_to_x = e.x
			end
		end
	end
	-- Завершённый ход игрока в арене, как в мире: тикает таймер перезарядки (GDD §7).
	equipment.tick(self.player.weapon)
	self.player.hp = a.player_hp
	self.world.pos.x = a.player_x
	local outcome = arena_outcome(self)
	local win_target = nil
	if outcome == "victory" then
		win_target = { x = self.world.pos.x, y = self.world.pos.y }
	end
	local steps = steps_arena(self, from_x, from_y, self.world.pos.x, boss_from_x, boss_to_x,
		events, outcome, win_target)
	if #steps == 0 then
		finish_view(self)
	else
		play_timeline(self, steps, function()
			finish_view(self)
		end)
	end
end

local function arena_shoot(self)
	local a = self.arena
	local row = self.world.pos.y
	local boss_x = a.boss_x
	local range = registry.equipment.CROSSBOW.range
	local ok, res = arena.shoot(a, self.player.weapon, self.player.weapon_damage, range)
	if not ok then
		print("refused: " .. tostring(res))
		return
	end
	local won = arena.result(a) == "victory"
	local win_target = nil
	if won then
		arena_outcome(self)
		win_target = { x = self.world.pos.x, y = self.world.pos.y }
	end
	local steps = steps_arena_shot(self, boss_x, row, res[1], won, win_target)
	if #steps == 0 then
		finish_view(self)
	else
		play_timeline(self, steps, function()
			finish_view(self)
		end)
	end
end

-- Ход на клетку / бой / выстрел только в режиме WORLD.
local function world_action(self, action_type, x, row)
	local from_x = self.world.pos.x
	local from_y = self.world.pos.y
	-- Шаг на нижний ряд арены: игрок встаёт на него и входит в бой. Обычные клетки там не используются.
	if action_type == "step" and is_arena_bottom(row) then
		local moved, reason = world.move(self.world, { x = x, y = row })
		if not moved then
			print("refused: " .. tostring(reason))
			return
		end
		self.player.gold, _ = camp.tick_payment(self.camp_state, self.player.gold)
		enter_arena(self)
		play_timeline(self, { slide_step(self, from_x, from_y, x, row) }, function()
			finish_view(self)
		end)
		return
	end
	local ok, events
	if action_type == "step" then
		ok, events = run.step(self.run, x, row)
	elseif action_type == "melee" then
		ok, events = run.melee(self.run, x, row)
	else
		ok, events = run.shoot(self.run, x)
	end
	apply_events(self, events)
	local moved = ok and has_event(events, "move")
	if moved then
		self.player.gold, _ = camp.tick_payment(self.camp_state, self.player.gold)
		local pos = self.world.pos
		if row_gen.kind(pos.y) == "checkpoint" and pos.y > self.world.return_point.row then
			world.set_return_point(self.world, "checkpoint", pos.y, pos.x)
			save(self)
		end
		if is_arena_bottom(pos.y) then
			enter_arena(self)
		end
	end
	local steps = {}
	if ok then
		if action_type == "melee" then
			steps = steps_melee(self, from_x, from_y, x, row, events)
		elseif action_type == "step" then
			steps = steps_step(self, from_x, from_y, events)
		else
			steps = steps_shoot(self, x, events)
		end
	end
	if #steps == 0 then
		finish_view(self)
	else
		play_timeline(self, steps, function()
			finish_view(self)
		end)
	end
end

function init(self)
	read_config(self)
	check_palette(self)
	msg.post(".", "acquire_input_focus")
	self.rows_id = go.get_id("rows")
	local data, found = saves.load()
	-- Новый мир при каждом запуске (GDD §18); debug_seed ≠ 0 фиксирует seed для тюнинга.
	-- В репозитории debug_seed всегда 0: ненулевое значение в коммите = зафиксированный мир у всех.
	-- Из сохранения живут только золото, прокачка и точка возврата.
	if self.debug_seed ~= 0 then
		self.seed = self.debug_seed
	else
		self.seed = math.floor((os.time() + os.clock()) * 1000) % 2147483647
	end
	self.upgrades = data.upgrades
	self.camp_state = camp.new_state()
	self.rows = {}
	self.cards = {}
	self.fx = {}
	self.input_locked = false
	self.anim_waiters = {}
	self.anim_token = 0
	self.player_go = nil
	self.boss_go = nil
	self.world = world.new(self.seed, 0)
	if found then
		local rp = data.return_point
		self.world.return_point = { kind = rp.kind, row = rp.row, x = rp.x }
		self.world.pos = { x = rp.x, y = rp.row }
		if rp.cells then
			-- Ряд точки возврата восстанавливается из сохранения, а не из генератора.
			local cells = {}
			for x = 0, layout.COLUMNS - 1 do
				cells[x] = { type = rp.cells[x + 1] }
			end
			self.rows[rp.row] = cells
		end
	end
	local stats = upgrades.stats({ levels = self.upgrades })
	self.player = {
		hp = stats.max_hp,
		max_hp = stats.max_hp,
		gold = data.gold,
		weapon = equipment.new(stats.max_charges, balance.player.weapon.rechargeTurns),
		weapon_damage = stats.weapon_damage,
	}
	self.run = {
		world = self.world,
		player = self.player,
		get_row = function(y)
			return get_row(self, y)
		end,
	}
	if not found then
		save(self)
	end
	finish_view(self)
end

function final(self)
	for _, row in pairs(self.cards) do
		for _, card in pairs(row) do
			go.delete(card.id)
		end
	end
	for _, id in ipairs(self.fx) do
		go.delete(id)
	end
	if self.player_go ~= nil then
		go.delete(self.player_go)
	end
	if self.boss_go ~= nil then
		go.delete(self.boss_go)
	end
	save(self)
end

function on_input(self, action_id, action)
	if action_id ~= hash("touch") or not action.pressed then
		return false
	end
	if self.input_locked then
		return true
	end
	local mode = self.world.mode
	if mode == MODES.DEATH then
		respawn(self)
		return true
	end
	if action.y < BUTTON_HEIGHT then
		if mode == MODES.WORLD then
			make_camp(self)
		elseif mode == MODES.CAMP then
			leave_camp(self)
		end
		return true
	end
	local x, row = layout.cell_at(action.x, action.y, self.world.pos.y)
	if x == nil then
		return true
	end
	if mode == MODES.BOSS and self.arena then
		local pr = self.world.pos.y
		if row == pr and x ~= self.arena.player_x then
			arena_move(self, x)
		elseif row == pr + 1 and x == self.arena.boss_x then
			arena_shoot(self)
		end
		return true
	end
	if mode ~= MODES.WORLD then
		return true
	end
	local target = (get_row(self, row) or {})[x]
	if row == self.world.pos.y + 1 and target and target.type == "ENEMY" then
		world_action(self, "melee", x, row)
	elseif row == self.world.pos.y + 1 then
		world_action(self, "step", x, row)
	elseif row == self.world.pos.y and target and target.type == "ENEMY" then
		world_action(self, "shoot", x, row)
	end
	return true
end

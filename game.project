[project]
title = Dungeon Card Crawler
version = 0.1.0

[bootstrap]
main_collection = /collections/world.collectionc

[render]
clear_color_red = 0.035
clear_color_green = 0.04
clear_color_blue = 0.047
clear_color_alpha = 1.0

[display]
width = 720
height = 1280
high_dpi = 1
dynamic_orientation = 0
update_frequency = 60
swap_interval = 1

[input]
use_accelerometer = 0

[label]
max_count = 512

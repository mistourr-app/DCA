-- Клетка-карта: прямоугольник-подложка (sprite) и надпись (label). Сообщение "set":
--   width, height (в логических px), color (фон), text, text_color.
-- Масштаб применяется только спрайту: label масштабить нельзя — растянется текст.
-- Сообщение "lift": {lift, duration} — подложка приподнимается (увеличивается) за duration
-- и за duration возвращается обратно: подъём карты игрока при перемещении.

local SPRITE_PX = 32

function on_message(self, message_id, message, sender)
	if message_id == hash("set") then
		go.cancel_animations("#sprite", "scale")
		self.base = vmath.vector3(message.width / SPRITE_PX, message.height / SPRITE_PX, 1)
		go.set("#sprite", "scale", self.base)
		go.set("#sprite", "tint", message.color)
		go.set("#label", "color", message.text_color)
		go.set("#label", "text", message.text)
	elseif message_id == hash("lift") then
		go.cancel_animations("#sprite", "scale")
		go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD,
			vmath.vector3(self.base.x * message.lift, self.base.y * message.lift, 1),
			vmath.EASE_OUT_BACK, message.duration, function()
				go.animate("#sprite", "scale", go.PLAYBACK_ONCE_FORWARD, self.base,
					vmath.EASE_IN_OUT_QUAD, message.duration)
			end)
	end
end

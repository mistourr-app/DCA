-- Геометрия поля: зазоры, толщина рамки карты, шаг и размер пунктира.
-- Презентационные числа; правятся в инспекторе инстанса world (docs/DEFOLD_INTEGRATION.md §5.2).
-- Читает collections/world.script через go.get("#geom_cfg", ...).
-- card_border — толщина рамки карты внутрь (px). Мир передаёт её карте в сообщении "set"
-- и тем же числом ужимает оверлей угрозы: подсветка покрывает только подложку, рамка
-- (индикация хода) остаётся видна при любой непрозрачности.

go.property("cell_gap", 8)
go.property("card_border", 3)
go.property("dash_step", 16)
go.property("dash_size", 4)

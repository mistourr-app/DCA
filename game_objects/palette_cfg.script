-- Палитра (GDD §16): роли вида карт и подсветок. Конкретный тип карты ссылается
-- на роль через scripts/view/style.lua; world.script при старте проверяет, что все роли заданы.
-- Правятся в инспекторе инстанса world (docs/DEFOLD_INTEGRATION.md §5.2).
-- Дефолты go.property — только литералы: значения пересчитаны из палитры GDD (hex/255).

-- Фон (fill) ролей карт.
go.property("fill_neutral", vmath.vector4(0.102, 0.114, 0.157, 1))
go.property("fill_wall", vmath.vector4(0.247, 0.271, 0.337, 1))
go.property("fill_good", vmath.vector4(0.063, 0.725, 0.506, 1))
go.property("fill_gold", vmath.vector4(1, 0.906, 0.38, 1))
go.property("fill_danger", vmath.vector4(1, 0.122, 0.122, 1))
go.property("fill_attack", vmath.vector4(0.769, 0, 0.078, 1))
go.property("fill_camp", vmath.vector4(0.361, 0.98, 1, 1))
go.property("fill_player", vmath.vector4(1, 1, 1, 1))

-- Чернила подписи: тёмные и светлые (по контрасту с фоном).
go.property("ink_dark", vmath.vector4(0, 0, 0, 1))
go.property("ink_light", vmath.vector4(1, 1, 1, 1))

-- Подсветки (GDD §5.4, §12): обводки ходов, пунктир выстрела, слой угроз.
go.property("outline_step", vmath.vector4(0.063, 0.725, 0.506, 1))
go.property("outline_jump", vmath.vector4(0.62, 0.427, 1, 1))
go.property("outline_attack", vmath.vector4(1, 0.122, 0.122, 1))
go.property("dot", vmath.vector4(1, 1, 1, 1))
go.property("vision", vmath.vector4(1, 0.451, 0.106, 1))
go.property("spotted", vmath.vector4(1, 0.122, 0.122, 1))

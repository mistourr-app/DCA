-- Клетка-карта: рамка (border), прямоугольник-подложка (sprite) и две подписи —
-- название (name) и значение (value) под ним. Сообщение "set": width, height (в логических px),
-- color (фон), border_color (рамка), border_width (её толщина), name, value, text_color.
-- Рамка — индикация хода, а не цвет карты: зелёная — шаг, фиолетовая — прыжок, прозрачная —
-- хода на клетку нет. Поэтому у карты нет «своей» обводки: её задаёт scripts/view/board.lua
-- по board.update_moves. Рамка стоит ВНУТРИ габарита карты: подложка ужимается на её толщину,
-- поэтому карта с рамкой не больше клетки, а соседние карты не соприкасаются.
-- У спрайта в Defold нет собственной обводки (docs/ENGINE_DEFOLD.md §3b), поэтому толщина
-- приходит числом border_width из geom_cfg.card_border (инспектор мира), а цвет — из палитры
-- (border_step/border_jump). Тем же числом мир ужимает оверлей угрозы, чтобы рамка оставалась
-- видимой; отступ считает core/layout.card_inset — один расчёт на карту и подсветку.
-- Прозрачная рамка (alpha = 0) — карта без рамки на всю площадь.
-- Масштаб применяется к подложке, обводке и обеим подписям сразу (anim.lift): при подъёме
-- карта растёт целиком, текст не «отклеивается» от неё.
-- Расстояние между строками задано позициями компонентов в card.go (инспектор).
-- Параметры анимаций заданы явно в card.go; здесь — те же значения как база для новых прототипов.
-- Примитивы lift/lunge/fall/flash — в scripts/view/anim.lua; здесь остаётся протокол сообщений.
-- Сообщения (по завершении шлют отправителю "anim_done" {token}):
--   "lift"  {duration} — подложка приподнимается до lift_scale и возвращается (секунды;
--         длительность задаёт мир, чтобы синхронно с полётом карты);
--   "lunge" {offset}   — выпад к цели и возврат (lunge_ms в каждую сторону);
--   "fall"  {offset}   — падение поверженной карты с уходом в прозрачность (fall_ms);
--   "flash" {}         — вспышка подложки flash_color (flash_ms, попадание арбалета).

-- Параметры анимаций: те же значения, что в card.go (правятся в инспекторе прототипа).
-- flash_color — vector4: x = red, y = green, z = blue, w = alpha (поля X/Y/Z/W в инспекторе).
local anim = require("scripts.view.anim")
local layout = require("core.layout")

go.property("lift_scale", 1.25)
go.property("lunge_ms", 150)
go.property("fall_ms", 600)
go.property("flash_ms", 100)
go.property("flash_color", vmath.vector4(1, 1, 1, 1))

local SPRITE_PX = 32
local ONE = vmath.vector3(1, 1, 1)

function init(self)
	-- Абсолютные url компонентов: anim.lua — обычный модуль без своего GO,
	-- относительные "#sprite"/"." резолвятся только в скрипте-GO.
	self.sprite_url = msg.url("#sprite")
	self.border_url = msg.url("#border")
	self.name_url = msg.url("#name")
	self.value_url = msg.url("#value")
	self.root_url = msg.url(".")
end

function on_message(self, message_id, message, sender)
	if message_id == hash("set") then
		go.cancel_animations(self.sprite_url, "scale")
		go.cancel_animations(self.sprite_url, "tint")
		go.cancel_animations(self.border_url, "scale")
		go.cancel_animations(self.border_url, "tint")
		go.cancel_animations(self.name_url, "color")
		go.cancel_animations(self.name_url, "scale")
		go.cancel_animations(self.value_url, "color")
		go.cancel_animations(self.value_url, "scale")
		go.cancel_animations(self.root_url, "position")
		self.color = message.color
		self.border_color = message.border_color or vmath.vector4(0, 0, 0, 0)
		-- Габарит карты — message.width/height: рамка занимает border_width по краю
		-- внутрь, подложка — остальное. Прозрачная рамка не рисуется и не ужимает
		-- подложку. Рамка не толще половины карты — иначе подложки не осталось бы.
		local inset = 0
		if self.border_color.w > 0 then
			inset = layout.card_inset(message.width, message.height, message.border_width or 0)
		end
		self.base = vmath.vector3((message.width - 2 * inset) / SPRITE_PX,
			(message.height - 2 * inset) / SPRITE_PX, 1)
		self.border_base = vmath.vector3(message.width / SPRITE_PX, message.height / SPRITE_PX, 1)
		go.set(self.sprite_url, "scale", self.base)
		go.set(self.sprite_url, "tint", self.color)
		go.set(self.border_url, "scale", self.border_base)
		go.set(self.border_url, "tint", self.border_color)
		go.set(self.name_url, "color", message.text_color)
		go.set(self.name_url, "scale", ONE)
		go.set(self.name_url, "text", message.name or "")
		go.set(self.value_url, "color", message.text_color)
		go.set(self.value_url, "scale", ONE)
		go.set(self.value_url, "text", message.value or "")
	elseif message_id == hash("lift") then
		anim.lift({ ms = message.duration, scale = self.lift_scale, parts = {
			{ url = self.sprite_url, base = self.base },
			{ url = self.border_url, base = self.border_base },
			{ url = self.name_url, base = ONE },
			{ url = self.value_url, base = ONE },
		} })
	elseif message_id == hash("lunge") then
		anim.lunge({ root = self.root_url, offset = message.offset, ms = self.lunge_ms,
			done = function() msg.post(sender, "anim_done", { token = message.token }) end })
	elseif message_id == hash("fall") then
		anim.fall({ root = self.root_url, sprite = self.sprite_url,
			border = self.border_url, border_color = self.border_color,
			labels = { self.name_url, self.value_url },
			offset = message.offset, ms = self.fall_ms, color = self.color,
			done = function() msg.post(sender, "anim_done", { token = message.token }) end })
	elseif message_id == hash("flash") then
		anim.flash({ sprite = self.sprite_url, from = self.color, to = self.flash_color,
			ms = self.flash_ms,
			done = function() msg.post(sender, "anim_done", { token = message.token }) end })
	end
end
